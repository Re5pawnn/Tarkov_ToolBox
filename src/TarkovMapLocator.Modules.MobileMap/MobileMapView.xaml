<UserControl x:Class="TarkovMapLocator.Modules.MobileMap.MobileMapView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#101514"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">
  <Grid Background="#101514">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <Grid Margin="24,22,24,24" MaxWidth="1080" HorizontalAlignment="Stretch">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel>
          <TextBlock Text="MOBILE MAP" Style="{StaticResource SectionLabel}" />
          <TextBlock Text="手机地图" Style="{StaticResource PageTitle}" />
        </StackPanel>

        <Border Grid.Row="1" Margin="0,20,0,0" Padding="20" Background="#111715" BorderBrush="{StaticResource LineBrightBrush}" BorderThickness="1" CornerRadius="10">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
              <TextBlock Text="手机地图服务" Foreground="{StaticResource TextBrush}" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" />
              <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Ellipse x:Name="ServerStateDot" Width="6" Height="6" Fill="{StaticResource TextFaintBrush}" Margin="0,0,7,0" />
                <TextBlock x:Name="ServerStateText" Text="未启动" Foreground="{StaticResource TextDimBrush}" FontSize="12" />
              </StackPanel>
            </Grid>

            <Grid Grid.Row="1" Margin="0,16,0,0">
              <Grid.ColumnDefinitions><ColumnDefinition Width="160" /><ColumnDefinition Width="12" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
              <StackPanel>
                <TextBlock Text="手机地图 / 队友共享端口" Foreground="{StaticResource TextFaintBrush}" FontSize="11" Margin="0,0,0,6" />
                <TextBox x:Name="PortBox" Style="{StaticResource FormTextBox}" MaxLength="5" PreviewTextInput="PortBox_PreviewTextInput" />
              </StackPanel>
              <StackPanel Grid.Column="2">
                <TextBlock Text="SakuraFrp 公网入口" Foreground="{StaticResource TextFaintBrush}" FontSize="11" Margin="0,0,0,6" />
                <TextBox x:Name="PublicEndpointBox" Style="{StaticResource FormTextBox}" TextChanged="PublicEndpointBox_TextChanged" LostFocus="PublicEndpointBox_LostFocus" ToolTip="例如 https://节点域名:远程端口" />
              </StackPanel>
            </Grid>

            <StackPanel Grid.Row="2" Margin="0,14,0,0">
              <TextBlock Text="手机访问地址" Foreground="{StaticResource TextFaintBrush}" FontSize="11" Margin="0,0,0,6" />
              <TextBox x:Name="EndpointBox" Style="{StaticResource FormTextBox}" IsReadOnly="True" Text="启动后生成访问地址" />
              <TextBlock x:Name="TunnelConfigText" Foreground="{StaticResource TextDimBrush}" FontSize="11" Margin="0,7,0,0" />
            </StackPanel>

            <WrapPanel Grid.Row="3" Margin="0,16,0,0">
              <Button x:Name="StartStopButton" Style="{StaticResource PageActionButton}" MinWidth="112" Click="StartStopButton_Click">启动共享服务</Button>
              <Button x:Name="CopyButton" Style="{StaticResource PageActionButton}" MinWidth="96" Margin="8,0,0,0" Click="CopyButton_Click" IsEnabled="False">复制地址</Button>
              <Button x:Name="PreviewButton" Style="{StaticResource PageActionButton}" MinWidth="96" Margin="8,0,0,0" Click="PreviewButton_Click" IsEnabled="False">本机预览</Button>
              <Button Style="{StaticResource PageActionButton}" MinWidth="112" Margin="8,0,0,0" Click="CopyTunnelConfigButton_Click">复制隧道参数</Button>
              <Button Style="{StaticResource PageActionButton}" MinWidth="112" Margin="8,0,0,0" Click="OpenSakuraFrpButton_Click">打开 SakuraFrp</Button>
            </WrapPanel>

            <Border Grid.Row="4" Height="1" Background="{StaticResource LineBrush}" Margin="0,18,0,14" />
            <Grid Grid.Row="4" Margin="0,29,0,0">
              <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
              <TextBlock x:Name="DetailText" Text="手机地图和队友位置共享使用同一端口、同一条 SakuraFrp 隧道。" Foreground="{StaticResource TextDimBrush}" FontSize="12" TextWrapping="Wrap" VerticalAlignment="Center" />
              <TextBlock Grid.Column="1" x:Name="ClientCountText" Text="0 台设备" Foreground="{StaticResource TextBrush}" FontSize="12" FontWeight="SemiBold" Margin="20,0,0,0" VerticalAlignment="Center" />
            </Grid>
          </Grid>
        </Border>

        <Border Grid.Row="2" Margin="0,12,0,0" Padding="18" Background="#111715" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="10">
          <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <Viewbox Width="28" Height="28" VerticalAlignment="Top" Margin="0,1,16,0">
              <Canvas Width="24" Height="24">
                <Rectangle Width="12" Height="20" Canvas.Left="6" Canvas.Top="2" RadiusX="2" RadiusY="2" Fill="Transparent" Stroke="{StaticResource GreenBrush}" StrokeThickness="1.7" />
                <Ellipse Width="1.8" Height="1.8" Canvas.Left="11.1" Canvas.Top="18.2" Fill="{StaticResource GreenBrush}" />
                <Path Data="M9,6 H15 M9,9 H15 M9,12 H13" Stroke="{StaticResource GreenBrush}" StrokeThickness="1.4" StrokeStartLineCap="Round" />
              </Canvas>
            </Viewbox>
            <StackPanel Grid.Column="1">
              <TextBlock Text="支持手机热点和移动网络" Foreground="{StaticResource TextBrush}" FontSize="13" FontWeight="SemiBold" />
              <TextBlock Text="在 SakuraFrp 创建 HTTPS 隧道：本地 IP 填 127.0.0.1，本地端口与上方一致。启动隧道后，把 HTTPS 连接地址完整粘贴到公网入口。" Foreground="{StaticResource TextDimBrush}" FontSize="12" LineHeight="20" TextWrapping="Wrap" Margin="0,7,0,0" />
            </StackPanel>
          </Grid>
        </Border>
      </Grid>
    </ScrollViewer>
  </Grid>
</UserControl>
