<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="TarkovMapLocator.App.Controls.MapCanvasControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <DataTemplate x:Key="RaidDetailRowTemplate">
            <Grid
                Margin="0,0,0,6"
                ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="120" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock
                    Grid.Column="0"
                    Foreground="#6F8798"
                    Text="{Binding Label}" />
                <TextBlock
                    Grid.Column="1"
                    Foreground="#D9E8F2"
                    Text="{Binding Value}"
                    TextWrapping="WrapWholeWords" />
            </Grid>
        </DataTemplate>
    </UserControl.Resources>
    <ScrollViewer
        Background="#071018"
        HorizontalScrollBarVisibility="Disabled"
        HorizontalScrollMode="Disabled"
        VerticalScrollBarVisibility="Auto"
        VerticalScrollMode="Auto">
        <Grid
            x:Name="Root"
            Padding="24,10,30,10"
            RowSpacing="8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border
                Grid.Row="0"
                Padding="12"
                Background="#0E1F2D"
                BorderBrush="#243A4A"
                BorderThickness="1"
                CornerRadius="8">
                <Grid RowSpacing="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <ScrollViewer
                        Grid.Row="0"
                        HorizontalScrollBarVisibility="Auto"
                        HorizontalScrollMode="Auto"
                        VerticalScrollBarVisibility="Disabled"
                        VerticalScrollMode="Disabled">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button
                                x:Name="PickScreenshotDirectoryButton"
                                MinWidth="110"
                                AutomationProperties.Name="Pick native screenshot directory"
                                Content="选择截图目录"
                                Click="OnPickScreenshotDirectoryClicked" />
                            <Button
                                x:Name="PickLogDirectoryButton"
                                MinWidth="110"
                                AutomationProperties.Name="Pick native Log directory"
                                Content="选择Log目录"
                                Click="OnPickLogDirectoryClicked" />
                            <Button
                                x:Name="WatchButton"
                                MinWidth="96"
                                AutomationProperties.Name="Toggle native screenshot listener"
                                Content="开始监听"
                                Click="OnToggleWatchClicked" />
                        </StackPanel>
                    </ScrollViewer>

                    <ScrollViewer
                        Grid.Row="1"
                        HorizontalScrollBarVisibility="Auto"
                        HorizontalScrollMode="Auto"
                        VerticalScrollBarVisibility="Disabled"
                        VerticalScrollMode="Disabled">
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="88" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="260" />
                            </Grid.ColumnDefinitions>

                            <TextBlock
                                Grid.Column="0"
                                VerticalAlignment="Center"
                                Foreground="#9BB2C2"
                                Text="轮询间隔(秒)" />
                            <NumberBox
                                x:Name="PollingIntervalBox"
                                Grid.Column="1"
                                AutomationProperties.Name="Native polling interval"
                                Minimum="1"
                                Maximum="30"
                                SpinButtonPlacementMode="Compact"
                                Value="2" />
                            <TextBlock
                                Grid.Column="2"
                                VerticalAlignment="Center"
                                Foreground="#9BB2C2"
                                Text="地图" />
                            <ComboBox
                                x:Name="MapSelector"
                                Grid.Column="3"
                                AutomationProperties.Name="Native map selector"
                                DisplayMemberPath="DisplayName"
                                MinWidth="220"
                                SelectionChanged="OnMapSelectorSelectionChanged" />
                            <ComboBox
                                x:Name="MapBaseSelector"
                                Grid.Column="3"
                                AutomationProperties.Name="Native map base selector"
                                MinWidth="130"
                                Visibility="Collapsed"
                                SelectionChanged="OnMapBaseSelectionChanged" />
                            <TextBlock
                                x:Name="ScreenshotDirectoryText"
                                Grid.Column="3"
                                VerticalAlignment="Center"
                                FontFamily="Consolas"
                                Foreground="#6F8798"
                                Text="截图目录: 未选择"
                                Visibility="Collapsed" />
                            <TextBlock
                                x:Name="LogDirectoryText"
                                Grid.Column="3"
                                VerticalAlignment="Center"
                                FontFamily="Consolas"
                                Foreground="#6F8798"
                                Text="Log目录: 未选择"
                                Visibility="Collapsed" />
                        </Grid>
                    </ScrollViewer>

                    <ScrollViewer
                        Grid.Row="2"
                        HorizontalScrollBarVisibility="Auto"
                        HorizontalScrollMode="Auto"
                        VerticalScrollBarVisibility="Disabled"
                        VerticalScrollMode="Disabled">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <TextBlock
                                x:Name="MapStatusText"
                                FontFamily="Consolas"
                                Foreground="#9BB2C2"
                                Text="地图状态: 未加载" />
                            <TextBlock
                                x:Name="PoiCountText"
                                FontFamily="Consolas"
                                Foreground="#9BB2C2"
                                Text="0 个点位" />
                        </StackPanel>
                    </ScrollViewer>

                    <ScrollViewer
                        Grid.Row="3"
                        HorizontalScrollBarVisibility="Auto"
                        HorizontalScrollMode="Auto"
                        VerticalScrollBarVisibility="Disabled"
                        VerticalScrollMode="Disabled">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock
                                VerticalAlignment="Center"
                                Foreground="#6F8798"
                                Text="原生地图控制" />
                            <Button
                                AutomationProperties.Name="Refresh native player position"
                                Content="刷新坐标"
                                Click="OnRefreshPositionClicked" />
                            <Button
                                x:Name="AutoRefreshButton"
                                AutomationProperties.Name="Auto refresh native player position"
                                Content="自动刷新: Off"
                                Click="OnAutoRefreshClicked" />
                            <Button
                                x:Name="AutoMapButton"
                                AutomationProperties.Name="Auto switch native map"
                                Content="自动地图: Off"
                                Click="OnAutoMapClicked" />
                            <Button
                                x:Name="PipButton"
                                AutomationProperties.Name="Toggle native map picture in picture"
                                Content="画中画: Off"
                                Click="OnPipClicked" />
                            <DropDownButton
                                Content="维护">
                                <DropDownButton.Flyout>
                                    <MenuFlyout>
                                        <MenuFlyoutItem
                                            Text="缓存检查"
                                            Click="OnCheckMapCacheClicked" />
                                        <MenuFlyoutItem
                                            Text="启动页: Native"
                                            Click="OnStartupPageClicked" />
                                    </MenuFlyout>
                                </DropDownButton.Flyout>
                            </DropDownButton>
                        </StackPanel>
                    </ScrollViewer>

                    <TextBlock
                        x:Name="StatusLineText"
                        Grid.Row="4"
                        Foreground="#65D4FF"
                        Text="状态: Native Map 预览已加载。" />
                </Grid>
            </Border>

            <Border
                Grid.Row="1"
                Padding="10"
                Background="#0E1F2D"
                BorderBrush="#243A4A"
                BorderThickness="1"
                CornerRadius="8">
                <Grid RowSpacing="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Border
                        Grid.Row="0"
                        Padding="8"
                        Background="#102838"
                        BorderBrush="#243A4A"
                        BorderThickness="1"
                        CornerRadius="8">
                        <Grid RowSpacing="8">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock
                                Grid.Row="0"
                                FontWeight="SemiBold"
                                Foreground="#F5F8FC"
                                Text="点位显示" />
                            <ScrollViewer
                                Grid.Row="1"
                                HorizontalScrollBarVisibility="Auto"
                                HorizontalScrollMode="Auto"
                                VerticalScrollBarVisibility="Disabled"
                                VerticalScrollMode="Disabled">
                                <StackPanel Orientation="Horizontal" Spacing="12">
                                    <CheckBox
                                        x:Name="ShowPoiButton"
                                        AutomationProperties.Name="Show native map POI"
                                        Content="显示点位"
                                        IsChecked="True"
                                        Click="OnShowPoiClicked" />
                                    <TextBlock
                                        VerticalAlignment="Center"
                                        Foreground="#9BB2C2"
                                        Text="点位来源" />
                                    <ComboBox
                                        x:Name="PoiSourceSelector"
                                        AutomationProperties.Name="Native POI source selector"
                                        MinWidth="130"
                                        SelectionChanged="OnPoiSourceSelectionChanged" />
                                    <TextBlock
                                        VerticalAlignment="Center"
                                        Foreground="#6F8798"
                                        Text="分类" />
                                    <ItemsRepeater
                                        x:Name="PoiFilterRepeater"
                                        AutomationProperties.Name="Native POI category filters">
                                        <ItemsRepeater.Layout>
                                            <StackLayout Orientation="Horizontal" Spacing="8" />
                                        </ItemsRepeater.Layout>
                                        <ItemsRepeater.ItemTemplate>
                                            <DataTemplate>
                                                <CheckBox
                                                    MinWidth="92"
                                                    AutomationProperties.Name="{Binding AutomationName}"
                                                    Content="{Binding DisplayLabel}"
                                                    IsChecked="{Binding IsEnabled}"
                                                    IsEnabled="{Binding HasItems}"
                                                    Tag="{Binding Kind}"
                                                    Click="OnPoiFilterClicked" />
                                            </DataTemplate>
                                        </ItemsRepeater.ItemTemplate>
                                    </ItemsRepeater>
                                </StackPanel>
                            </ScrollViewer>
                        </Grid>
                    </Border>

                    <Border
                        x:Name="Viewport"
                        Grid.Row="1"
                        MinHeight="0"
                        Background="#0B1620"
                        BorderBrush="#243A4A"
                        BorderThickness="1"
                        CornerRadius="8"
                        SizeChanged="OnViewportSizeChanged"
                        PointerPressed="OnViewportPointerPressed"
                        PointerMoved="OnViewportPointerMoved"
                        PointerReleased="OnViewportPointerReleased"
                        PointerCanceled="OnViewportPointerReleased"
                        PointerWheelChanged="OnViewportPointerWheelChanged">
                        <Grid
                            x:Name="ViewportContent"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Stretch">
                            <Grid
                                x:Name="MapViewportSurface"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Top">
                                <Canvas
                                    x:Name="MapLayer"
                                    RenderTransformOrigin="0,0">
                                    <Canvas.RenderTransform>
                                        <CompositeTransform x:Name="MapTransform" />
                                    </Canvas.RenderTransform>
                                    <Image
                                        x:Name="MapImage"
                                        Stretch="Fill"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Top" />
                                </Canvas>
                                <Canvas
                                    x:Name="OverlayLayer"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Top" />
                            </Grid>
                            <StackPanel
                                Canvas.ZIndex="10"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Top"
                                Margin="10"
                                Spacing="6">
                                <Button
                                    Width="38"
                                    Height="34"
                                    AutomationProperties.Name="Zoom in native map"
                                    Content="+"
                                    FontSize="18"
                                    FontWeight="SemiBold"
                                    Click="OnZoomInClicked" />
                                <Button
                                    Width="38"
                                    Height="34"
                                    AutomationProperties.Name="Zoom out native map"
                                    Content="-"
                                    FontSize="18"
                                    FontWeight="SemiBold"
                                    Click="OnZoomOutClicked" />
                                <Button
                                    Width="38"
                                    Height="34"
                                    AutomationProperties.Name="Fit native map"
                                    Content="Fit"
                                    FontSize="11"
                                    Click="OnFitClicked" />
                            </StackPanel>
                            <TextBlock
                                x:Name="EmptyStateText"
                                Canvas.ZIndex="20"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Padding="16"
                                Foreground="#9BB2C2"
                                Text="正在加载原生地图预览..."
                                TextAlignment="Center"
                                TextWrapping="WrapWholeWords" />
                        </Grid>
                    </Border>

                    <Border
                        Grid.Row="2"
                        Padding="10"
                        Background="#102838"
                        BorderBrush="#34566B"
                        BorderThickness="1"
                        CornerRadius="8">
                        <Grid RowSpacing="8">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0" ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ScrollViewer
                                    Grid.Column="0"
                                    HorizontalScrollBarVisibility="Auto"
                                    HorizontalScrollMode="Auto"
                                    VerticalScrollBarVisibility="Disabled"
                                    VerticalScrollMode="Disabled">
                                    <ItemsRepeater
                                        x:Name="RaidSummaryRepeater"
                                        AutomationProperties.Name="Native raid summary">
                                        <ItemsRepeater.Layout>
                                            <StackLayout Orientation="Horizontal" Spacing="8" />
                                        </ItemsRepeater.Layout>
                                        <ItemsRepeater.ItemTemplate>
                                            <DataTemplate>
                                                <Border
                                                    MinWidth="112"
                                                    Padding="10,7"
                                                    Background="#16384A"
                                                    BorderBrush="#34566B"
                                                    BorderThickness="1"
                                                    CornerRadius="7">
                                                    <StackPanel Spacing="2">
                                                        <TextBlock
                                                            FontSize="11"
                                                            Foreground="#6F8798"
                                                            Text="{Binding Label}" />
                                                        <TextBlock
                                                            FontWeight="SemiBold"
                                                            Foreground="#F5F8FC"
                                                            Text="{Binding Value}"
                                                            TextTrimming="CharacterEllipsis" />
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsRepeater.ItemTemplate>
                                    </ItemsRepeater>
                                </ScrollViewer>
                                <Button
                                    x:Name="RaidDetailsButton"
                                    Grid.Column="1"
                                    MinWidth="92"
                                    AutomationProperties.Name="Toggle native raid details"
                                    Content="展开详情"
                                    Click="OnRaidDetailsClicked" />
                            </Grid>

                            <Grid
                                x:Name="RaidDetailsPanel"
                                Grid.Row="1"
                                RowSpacing="8"
                                Visibility="Collapsed">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid
                                    Grid.Row="0"
                                    ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border
                                        Grid.Column="0"
                                        Padding="10"
                                        Background="#0E1F2D"
                                        BorderBrush="#243A4A"
                                        BorderThickness="1"
                                        CornerRadius="7">
                                        <StackPanel Spacing="8">
                                            <TextBlock
                                                FontSize="14"
                                                FontWeight="SemiBold"
                                                Foreground="#F5F8FC"
                                                Text="当前战局" />
                                            <ItemsRepeater
                                                x:Name="RaidCurrentRepeater"
                                                AutomationProperties.Name="Native current raid details"
                                                ItemTemplate="{StaticResource RaidDetailRowTemplate}" />
                                        </StackPanel>
                                    </Border>
                                    <Border
                                        Grid.Column="1"
                                        Padding="10"
                                        Background="#0E1F2D"
                                        BorderBrush="#243A4A"
                                        BorderThickness="1"
                                        CornerRadius="7">
                                        <StackPanel Spacing="8">
                                            <TextBlock
                                                FontSize="14"
                                                FontWeight="SemiBold"
                                                Foreground="#F5F8FC"
                                                Text="时间信息" />
                                            <ItemsRepeater
                                                x:Name="RaidTimingRepeater"
                                                AutomationProperties.Name="Native raid timing details"
                                                ItemTemplate="{StaticResource RaidDetailRowTemplate}" />
                                        </StackPanel>
                                    </Border>
                                </Grid>
                                <Border
                                    Grid.Row="1"
                                    Padding="10"
                                    Background="#0E1F2D"
                                    BorderBrush="#243A4A"
                                    BorderThickness="1"
                                    CornerRadius="7">
                                    <StackPanel Spacing="8">
                                        <TextBlock
                                            FontSize="14"
                                            FontWeight="SemiBold"
                                            Foreground="#F5F8FC"
                                            Text="最近事件" />
                                        <ItemsRepeater
                                            x:Name="RaidEventsRepeater"
                                            AutomationProperties.Name="Native raid recent events">
                                            <ItemsRepeater.ItemTemplate>
                                                <DataTemplate>
                                                    <Border
                                                        Margin="0,0,0,6"
                                                        Padding="8"
                                                        Background="#132B3A"
                                                        BorderBrush="#243A4A"
                                                        BorderThickness="1"
                                                        CornerRadius="6">
                                                        <Grid RowSpacing="3">
                                                            <Grid.RowDefinitions>
                                                                <RowDefinition Height="Auto" />
                                                                <RowDefinition Height="Auto" />
                                                            </Grid.RowDefinitions>
                                                            <Grid ColumnSpacing="8">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*" />
                                                                    <ColumnDefinition Width="Auto" />
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock
                                                                    Grid.Column="0"
                                                                    FontWeight="SemiBold"
                                                                    Foreground="#F5F8FC"
                                                                    Text="{Binding Title}" />
                                                                <TextBlock
                                                                    Grid.Column="1"
                                                                    Foreground="#6F8798"
                                                                    Text="{Binding Time}" />
                                                            </Grid>
                                                            <TextBlock
                                                                Grid.Row="1"
                                                                Foreground="#9BB2C2"
                                                                Text="{Binding Detail}"
                                                                TextWrapping="WrapWholeWords" />
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsRepeater.ItemTemplate>
                                        </ItemsRepeater>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Grid>
                    </Border>

                    <Border
                        Grid.Row="3"
                        Padding="10"
                        Background="#102838"
                        BorderBrush="#34566B"
                        BorderThickness="1"
                        CornerRadius="8">
                        <Grid RowSpacing="8">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <StackPanel Grid.Row="0">
                                <TextBlock
                                    FontSize="16"
                                    FontWeight="SemiBold"
                                    Foreground="#F5F8FC"
                                    Text="队友同步" />
                                <TextBlock
                                    Foreground="#6F8798"
                                    Text="通过樱花穿透或局域网和队友共享地图位置" />
                            </StackPanel>
                            <ScrollViewer
                                Grid.Row="1"
                                HorizontalScrollBarVisibility="Auto"
                                HorizontalScrollMode="Auto"
                                VerticalScrollBarVisibility="Disabled"
                                VerticalScrollMode="Disabled">
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="280" />
                                        <ColumnDefinition Width="360" />
                                        <ColumnDefinition Width="360" />
                                    </Grid.ColumnDefinitions>
                                    <Border
                                        Grid.Column="0"
                                        Padding="10"
                                        Background="#0E1F2D"
                                        BorderBrush="#243A4A"
                                        BorderThickness="1"
                                        CornerRadius="7">
                                        <StackPanel Spacing="8">
                                            <TextBlock
                                                FontWeight="SemiBold"
                                                Foreground="#F5F8FC"
                                                Text="我的信息" />
                                            <TextBox
                                                x:Name="SyncNameTextBox"
                                                Header="昵称"
                                                TextChanged="OnSyncConfigChanged"
                                                PlaceholderText="输入你的名称" />
                                            <ComboBox
                                                x:Name="SyncColorComboBox"
                                                Header="标记颜色"
                                                SelectionChanged="OnSyncConfigSelectionChanged">
                                                <ComboBoxItem Content="#4fd1ff" />
                                                <ComboBoxItem Content="#ffb020" />
                                                <ComboBoxItem Content="#7bd88f" />
                                                <ComboBoxItem Content="#d48cff" />
                                                <ComboBoxItem Content="#ff6b6b" />
                                            </ComboBox>
                                        </StackPanel>
                                    </Border>
                                    <Border
                                        Grid.Column="1"
                                        Padding="10"
                                        Background="#0E1F2D"
                                        BorderBrush="#243A4A"
                                        BorderThickness="1"
                                        CornerRadius="7">
                                        <StackPanel Spacing="8">
                                            <TextBlock
                                                FontWeight="SemiBold"
                                                Foreground="#F5F8FC"
                                                Text="我是房主" />
                                            <StackPanel Spacing="4">
                                                <TextBlock
                                                    FontSize="12"
                                                    Foreground="#D7E8F7"
                                                    Text="樱花穿透转发本机端口" />
                                                <Border
                                                    Padding="10,8"
                                                    Background="#162A39"
                                                    BorderBrush="#31495B"
                                                    BorderThickness="1"
                                                    CornerRadius="6">
                                                    <TextBlock
                                                        x:Name="SyncLocalEndpointText"
                                                        FontSize="14"
                                                        Foreground="#F5F8FC"
                                                        Text="39247" />
                                                </Border>
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <Button
                                                    x:Name="SyncHostButton"
                                                    Content="开启房间"
                                                    Click="OnSyncHostClicked" />
                                                <Button
                                                    x:Name="SyncStopButton"
                                                    Content="停止同步"
                                                    IsEnabled="False"
                                                    Click="OnSyncStopClicked" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                    <Border
                                        Grid.Column="2"
                                        Padding="10"
                                        Background="#0E1F2D"
                                        BorderBrush="#243A4A"
                                        BorderThickness="1"
                                        CornerRadius="7">
                                        <StackPanel Spacing="8">
                                            <TextBlock
                                                FontWeight="SemiBold"
                                                Foreground="#F5F8FC"
                                                Text="我要加入队友" />
                                            <TextBlock
                                                FontSize="12"
                                                Foreground="#9DB4C8"
                                                Text="这里只负责连接房主，不控制左侧房主开关" />
                                            <TextBox
                                                x:Name="SyncRemoteEndpointTextBox"
                                                Header="队友给你的地址"
                                                TextChanged="OnSyncConfigChanged"
                                                PlaceholderText="例如 xxx.natfrp.cloud:12345" />
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <Button
                                                    x:Name="SyncJoinButton"
                                                    Content="加入队友"
                                                    Click="OnSyncJoinClicked" />
                                                <Button
                                                    x:Name="SyncJoinDisconnectButton"
                                                    Content="断开队友"
                                                    Click="OnSyncStopClicked"
                                                    Visibility="Collapsed" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </ScrollViewer>
                            <Border
                                Grid.Row="2"
                                Padding="10"
                                Background="#0E1F2D"
                                BorderBrush="#243A4A"
                                BorderThickness="1"
                                CornerRadius="7">
                                <StackPanel Spacing="4">
                                    <TextBlock
                                        FontWeight="SemiBold"
                                        Foreground="#F5F8FC"
                                        Text="连接状态" />
                                    <TextBlock
                                        x:Name="SyncStatusText"
                                        Foreground="#9BB2C2"
                                        Text="未开启同步" />
                                    <TextBlock
                                        x:Name="SyncHintText"
                                        Foreground="#65D4FF"
                                        Text="房主开启房间后，在樱花穿透里把本机端口 39247 转发出去，再把外网地址发给队友。"
                                        TextWrapping="WrapWholeWords" />
                                    <TextBlock
                                        x:Name="SyncErrorText"
                                        Foreground="#FFB020"
                                        Text=""
                                        Visibility="Collapsed"
                                        TextWrapping="WrapWholeWords" />
                                </StackPanel>
                            </Border>
                            <StackPanel Grid.Row="3" Spacing="6">
                                <TextBlock
                                    FontWeight="SemiBold"
                                    Foreground="#F5F8FC"
                                    Text="同步成员" />
                                <ItemsRepeater
                                    x:Name="SyncPeerRepeater"
                                    AutomationProperties.Name="Native LAN peer list">
                                    <ItemsRepeater.ItemTemplate>
                                        <DataTemplate>
                                            <Border
                                                Margin="0,0,0,6"
                                                Padding="8"
                                                Background="#132B3A"
                                                BorderBrush="#243A4A"
                                                BorderThickness="1"
                                                CornerRadius="6">
                                                <Grid ColumnSpacing="8">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="130" />
                                                        <ColumnDefinition Width="90" />
                                                        <ColumnDefinition Width="130" />
                                                        <ColumnDefinition Width="100" />
                                                        <ColumnDefinition Width="90" />
                                                    </Grid.ColumnDefinitions>
                                                    <Border
                                                        Grid.Column="0"
                                                        Width="14"
                                                        Height="14"
                                                        Background="{Binding Color}"
                                                        CornerRadius="7"
                                                        VerticalAlignment="Center" />
                                                    <TextBlock
                                                        Grid.Column="1"
                                                        Foreground="#F5F8FC"
                                                        FontWeight="SemiBold"
                                                        Text="{Binding DisplayName}"
                                                        TextTrimming="CharacterEllipsis" />
                                                    <TextBlock
                                                        Grid.Column="2"
                                                        Foreground="#65D4FF"
                                                        Text="{Binding RoleText}"
                                                        TextTrimming="CharacterEllipsis" />
                                                    <TextBlock
                                                        Grid.Column="3"
                                                        Foreground="#9BB2C2"
                                                        Text="{Binding MapName}"
                                                        TextTrimming="CharacterEllipsis" />
                                                    <TextBlock
                                                        Grid.Column="4"
                                                        Foreground="#9BB2C2"
                                                        Text="{Binding LastSeenText}" />
                                                    <TextBlock
                                                        Grid.Column="5"
                                                        Foreground="#65D4FF"
                                                        Text="{Binding VisibilityStatus}" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsRepeater.ItemTemplate>
                                </ItemsRepeater>
                            </StackPanel>
                            <Border
                                Grid.Row="4"
                                Padding="10"
                                Background="#0E1F2D"
                                BorderBrush="#243A4A"
                                BorderThickness="1"
                                CornerRadius="7">
                                <Grid RowSpacing="8">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <StackPanel Grid.Row="0">
                                        <TextBlock
                                            FontSize="16"
                                            FontWeight="SemiBold"
                                            Foreground="#F5F8FC"
                                            Text="屏幕滤镜" />
                                        <TextBlock
                                            Foreground="#6F8798"
                                            Text="调整显示器 Gamma，不处理地图图片" />
                                    </StackPanel>
                                    <Grid
                                        Grid.Row="1"
                                        ColumnSpacing="8"
                                        RowSpacing="8">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <ComboBox
                                            x:Name="ScreenFilterPresetComboBox"
                                            Grid.Row="0"
                                            Grid.Column="0"
                                            Header="预设"
                                            DisplayMemberPath="Label"
                                            MinWidth="0"
                                            SelectionChanged="OnScreenFilterPresetChanged" />
                                        <ComboBox
                                            x:Name="ScreenFilterDisplayComboBox"
                                            Grid.Row="0"
                                            Grid.Column="1"
                                            Header="屏幕"
                                            DisplayMemberPath="Label"
                                            MinWidth="0"
                                            SelectionChanged="OnScreenFilterDisplayChanged" />
                                        <NumberBox
                                            x:Name="ScreenFilterGammaBox"
                                            Grid.Row="1"
                                            Grid.Column="0"
                                            Header="伽马"
                                            Minimum="0.2"
                                            Maximum="5"
                                            MinWidth="0"
                                            SmallChange="0.05"
                                            SpinButtonPlacementMode="Compact"
                                            ValueChanged="OnScreenFilterNumberChanged" />
                                        <NumberBox
                                            x:Name="ScreenFilterBrightnessBox"
                                            Grid.Row="1"
                                            Grid.Column="1"
                                            Header="亮度"
                                            Minimum="-100"
                                            Maximum="100"
                                            MinWidth="0"
                                            SmallChange="1"
                                            SpinButtonPlacementMode="Compact"
                                            ValueChanged="OnScreenFilterNumberChanged" />
                                        <NumberBox
                                            x:Name="ScreenFilterContrastBox"
                                            Grid.Row="2"
                                            Grid.Column="0"
                                            Header="对比"
                                            Minimum="-100"
                                            Maximum="100"
                                            MinWidth="0"
                                            SmallChange="1"
                                            SpinButtonPlacementMode="Compact"
                                            ValueChanged="OnScreenFilterNumberChanged" />
                                        <NumberBox
                                            x:Name="ScreenFilterRedBox"
                                            Grid.Row="2"
                                            Grid.Column="1"
                                            Header="红"
                                            Minimum="0"
                                            Maximum="255"
                                            MinWidth="0"
                                            SmallChange="1"
                                            SpinButtonPlacementMode="Compact"
                                            ValueChanged="OnScreenFilterNumberChanged" />
                                        <NumberBox
                                            x:Name="ScreenFilterGreenBox"
                                            Grid.Row="3"
                                            Grid.Column="0"
                                            Header="绿"
                                            Minimum="0"
                                            Maximum="255"
                                            MinWidth="0"
                                            SmallChange="1"
                                            SpinButtonPlacementMode="Compact"
                                            ValueChanged="OnScreenFilterNumberChanged" />
                                        <NumberBox
                                            x:Name="ScreenFilterBlueBox"
                                            Grid.Row="3"
                                            Grid.Column="1"
                                            Header="蓝"
                                            Minimum="0"
                                            Maximum="255"
                                            MinWidth="0"
                                            SmallChange="1"
                                            SpinButtonPlacementMode="Compact"
                                            ValueChanged="OnScreenFilterNumberChanged" />
                                        <StackPanel
                                            Grid.Row="4"
                                            Grid.Column="0"
                                            Grid.ColumnSpan="2"
                                            Orientation="Horizontal"
                                            Spacing="8">
                                            <Button
                                                x:Name="ScreenFilterApplyButton"
                                                Content="应用滤镜"
                                                Click="OnScreenFilterApplyClicked" />
                                            <Button
                                                x:Name="ScreenFilterResetButton"
                                                Content="恢复默认"
                                                Click="OnScreenFilterResetClicked" />
                                        </StackPanel>
                                        <TextBlock
                                            x:Name="ScreenFilterStatusText"
                                            Grid.Row="5"
                                            Grid.Column="0"
                                            Grid.ColumnSpan="2"
                                            Foreground="#9BB2C2"
                                            Text="屏幕滤镜: 未应用"
                                            TextWrapping="WrapWholeWords" />
                                    </Grid>
                                </Grid>
                            </Border>
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </ScrollViewer>
</UserControl>
