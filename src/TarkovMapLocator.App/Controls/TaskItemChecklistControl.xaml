<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="TarkovMapLocator.App.Controls.TaskItemChecklistControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    RequestedTheme="Dark"
    Loaded="OnLoaded"
    SizeChanged="OnSizeChanged"
    Unloaded="OnUnloaded">
    <UserControl.Resources>
        <SolidColorBrush x:Key="TrackerTextBrush" Color="#D6E3ED" />
        <SolidColorBrush x:Key="TrackerMutedBrush" Color="#94ACBA" />
        <SolidColorBrush x:Key="TrackerLineBrush" Color="#2B4A5D" />
        <SolidColorBrush x:Key="TrackerAccentBrush" Color="#7DFF73" />
        <SolidColorBrush x:Key="TrackerAccent2Brush" Color="#2AD9FF" />
        <SolidColorBrush x:Key="TrackerWarnBrush" Color="#FFD166" />
        <SolidColorBrush x:Key="TrackerDangerBrush" Color="#FF6B6B" />
        <SolidColorBrush x:Key="TrackerInputBrush" Color="#102838" />
        <SolidColorBrush x:Key="TrackerChipBrush" Color="#B8102838" />
        <SolidColorBrush x:Key="TrackerChipLineBrush" Color="#C6466A7E" />

        <DataTemplate x:Key="SourceRowTemplate">
            <Border
                Margin="0,0,0,6"
                Padding="7,5"
                Background="#65101824"
                BorderBrush="#442B4A5D"
                BorderThickness="1"
                CornerRadius="6">
            <Grid
                ColumnSpacing="8"
                MinHeight="28">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="18" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="56" />
                </Grid.ColumnDefinitions>
                <TextBlock
                    Grid.Column="0"
                    VerticalAlignment="Center"
                    FontSize="13"
                    FontWeight="Black"
                    Foreground="#3FFF5F"
                    Text="{Binding CheckText}" />
                <TextBlock
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    FontSize="12"
                    Foreground="{Binding TextBrush}"
                    LineHeight="16"
                    MaxLines="2"
                    Text="{Binding DisplayText}"
                    TextTrimming="CharacterEllipsis"
                    TextWrapping="WrapWholeWords" />
                <Button
                    Grid.Column="2"
                    MinHeight="26"
                    MinWidth="52"
                    Padding="6,2"
                    HorizontalAlignment="Right"
                    Background="{Binding DoneButtonBrush}"
                    BorderBrush="{Binding DoneButtonBorderBrush}"
                    BorderThickness="1"
                    Click="OnSourceDoneClicked"
                    Content="{Binding DoneButtonText}"
                    FontSize="11"
                    FontWeight="Bold"
                    Foreground="{Binding DoneButtonForeground}"
                    IsEnabled="{Binding IsNotPending}" />
            </Grid>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="TrackerItemTemplate">
            <Border
                MinHeight="0"
                Padding="12"
                Background="#1C1D20"
                BorderBrush="#E65E636D"
                BorderThickness="1"
                CornerRadius="8">
                <Grid RowSpacing="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid
                        Grid.Row="0"
                        ColumnSpacing="12"
                        RowSpacing="8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="54" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Border
                            Grid.Row="0"
                            Grid.Column="0"
                            Width="54"
                            Height="54"
                            Background="#111317"
                            BorderBrush="#E6464D55"
                            BorderThickness="1"
                            CornerRadius="4">
                            <Grid>
                                <Image
                                    Margin="2"
                                    Source="{Binding IconSource}"
                                    Stretch="Uniform"
                                    Visibility="{Binding IconVisibility}" />
                                <TextBlock
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    FontWeight="Black"
                                    Foreground="{StaticResource TrackerMutedBrush}"
                                    Text="?"
                                    Visibility="{Binding PlaceholderVisibility}" />
                            </Grid>
                        </Border>

                        <Grid
                            Grid.Row="0"
                            Grid.Column="1"
                            MinWidth="0"
                            RowSpacing="4">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock
                                Grid.Row="0"
                                FontSize="15"
                                FontWeight="SemiBold"
                                Foreground="#FFD35A"
                                LineHeight="19"
                                MaxLines="2"
                                Text="{Binding DisplayName}"
                                TextTrimming="CharacterEllipsis"
                                TextWrapping="WrapWholeWords" />
                            <TextBlock
                                Grid.Row="1"
                                FontSize="12"
                                Foreground="#8FC7F0"
                                MaxLines="1"
                                Text="{Binding Subtitle}"
                                TextTrimming="CharacterEllipsis" />
                            <StackPanel
                                Grid.Row="2"
                                Margin="0,5,0,0"
                                Orientation="Horizontal"
                                Spacing="5">
                                <TextBlock
                                    FontSize="16"
                                    FontWeight="Bold"
                                    Foreground="#FFD35A"
                                    Text="{Binding ProgressHaveText}" />
                                <TextBlock
                                    FontSize="16"
                                    FontWeight="Bold"
                                    Foreground="#D6E5F0"
                                    Text="{Binding ProgressTotalText}" />
                                <TextBlock
                                    FontSize="11"
                                    FontWeight="Bold"
                                    Foreground="#44FF67"
                                    Text="{Binding FoundInRaidText}"
                                    Visibility="{Binding FoundInRaidVisibility}" />
                            </StackPanel>
                        </Grid>

                        <TextBlock
                            Grid.Row="0"
                            Grid.Column="2"
                            Margin="8,1,0,0"
                            FontFamily="Cascadia Mono, Consolas"
                            FontSize="11"
                            FontWeight="SemiBold"
                            Foreground="{StaticResource TrackerMutedBrush}"
                            Text="{Binding SourceCountText}" />
                    </Grid>

                    <StackPanel
                        Grid.Row="1"
                        Orientation="Horizontal"
                        Spacing="6">
                            <Border
                                Padding="7,3"
                                Background="{StaticResource TrackerChipBrush}"
                                BorderBrush="{StaticResource TrackerChipLineBrush}"
                                BorderThickness="1"
                                CornerRadius="8">
                                <TextBlock
                                    FontSize="12"
                                    Foreground="#BCD0DC"
                                    Text="{Binding TaskTotalText}" />
                            </Border>
                            <Border
                                Padding="7,3"
                                Background="{StaticResource TrackerChipBrush}"
                                BorderBrush="{StaticResource TrackerChipLineBrush}"
                                BorderThickness="1"
                                CornerRadius="8">
                                <TextBlock
                                    FontSize="12"
                                    Foreground="#BCD0DC"
                                    Text="{Binding HideoutTotalText}" />
                            </Border>
                            <Border
                                Padding="7,3"
                                Background="{StaticResource TrackerChipBrush}"
                                BorderBrush="{StaticResource TrackerChipLineBrush}"
                                BorderThickness="1"
                                CornerRadius="8">
                                <TextBlock
                                    FontSize="12"
                                    Foreground="#BCD0DC"
                                    Text="{Binding FoundInRaidChipText}" />
                            </Border>
                        </StackPanel>

                    <Grid
                        Grid.Row="2"
                        ColumnSpacing="6"
                        HorizontalAlignment="Stretch">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="34" />
                            <ColumnDefinition Width="72" />
                            <ColumnDefinition Width="34" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button
                            Grid.Column="0"
                            MinHeight="36"
                            Background="{StaticResource TrackerInputBrush}"
                            BorderBrush="{StaticResource TrackerLineBrush}"
                            BorderThickness="1"
                            Click="OnDecrementHaveClicked"
                            Content="-"
                            FontWeight="ExtraBold"
                            Foreground="{StaticResource TrackerTextBrush}"
                            IsEnabled="{Binding IsNotPending}" />
                        <TextBox
                            Grid.Column="1"
                            MinHeight="36"
                            Padding="6"
                            HorizontalContentAlignment="Center"
                            Background="{StaticResource TrackerInputBrush}"
                            BorderBrush="{StaticResource TrackerLineBrush}"
                            BorderThickness="1"
                            Foreground="{StaticResource TrackerTextBrush}"
                            InputScope="Number"
                            IsEnabled="{Binding IsNotPending}"
                            KeyDown="OnHaveBoxKeyDown"
                            LostFocus="OnHaveBoxLostFocus"
                            Text="{Binding HaveText, Mode=OneWay}" />
                        <Button
                            Grid.Column="2"
                            MinHeight="36"
                            Background="{StaticResource TrackerInputBrush}"
                            BorderBrush="{StaticResource TrackerLineBrush}"
                            BorderThickness="1"
                            Click="OnIncrementHaveClicked"
                            Content="+"
                            FontWeight="ExtraBold"
                            Foreground="{StaticResource TrackerTextBrush}"
                            IsEnabled="{Binding IsNotPending}" />
                    </Grid>

                    <Border
                        Grid.Row="3"
                        Padding="8"
                        Background="#8A0B151D"
                        BorderBrush="#772B4A5D"
                        BorderThickness="1"
                        CornerRadius="7">
                        <Grid RowSpacing="7">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock
                                    Grid.Column="0"
                                    VerticalAlignment="Center"
                                    FontSize="12"
                                    FontWeight="SemiBold"
                                    Foreground="{StaticResource TrackerMutedBrush}"
                                    Text="{Binding SourcesHeaderText}" />
                            </Grid>

                            <ScrollViewer
                                Grid.Row="1"
                                MaxHeight="198"
                                HorizontalScrollBarVisibility="Disabled"
                                HorizontalScrollMode="Disabled"
                                VerticalScrollBarVisibility="Auto"
                                VerticalScrollMode="Enabled">
                                <ItemsControl
                                    ItemTemplate="{StaticResource SourceRowTemplate}"
                                    ItemsSource="{Binding Sources}" />
                            </ScrollViewer>
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <ScrollViewer
        x:Name="RootScrollViewer"
        Background="#071018"
        HorizontalScrollBarVisibility="Disabled"
        HorizontalScrollMode="Disabled"
        VerticalScrollBarVisibility="Auto"
        VerticalScrollMode="Auto">
        <Grid
            x:Name="AppRoot"
            Padding="12,12,12,14"
            HorizontalAlignment="Left">
            <Border
                x:Name="TrackerPanel"
                Padding="12"
                BorderBrush="{StaticResource TrackerLineBrush}"
                BorderThickness="1"
                CornerRadius="12">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#EB172632" Offset="0" />
                        <GradientStop Color="#F20F1C25" Offset="1" />
                    </LinearGradientBrush>
                </Border.Background>

                <Grid RowSpacing="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid
                        x:Name="TrackerToolbar"
                        Grid.Row="0"
                        ColumnSpacing="10"
                        RowSpacing="8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="150" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel
                            x:Name="SearchField"
                            Grid.Column="0"
                            Spacing="6">
                            <TextBlock
                                FontSize="13"
                                Foreground="{StaticResource TrackerMutedBrush}"
                                Text="物品搜索" />
                            <TextBox
                                x:Name="SearchBox"
                                MinWidth="260"
                                Padding="10,8"
                                AutomationProperties.Name="物品搜索"
                                Background="{StaticResource TrackerInputBrush}"
                                BorderBrush="{StaticResource TrackerLineBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                FontSize="15"
                                Foreground="{StaticResource TrackerTextBrush}"
                                PlaceholderText="输入物品名、简称或ID"
                                TextChanged="OnSearchTextChanged" />
                        </StackPanel>

                        <Border
                            x:Name="ModeToggle"
                            Grid.Column="1"
                            Padding="4"
                            VerticalAlignment="Bottom"
                            Background="#B808121A"
                            BorderBrush="#E6334F5E"
                            BorderThickness="1"
                            CornerRadius="10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Button
                                    x:Name="PvpButton"
                                    Grid.Column="0"
                                    MinWidth="64"
                                    Padding="12,8"
                                    BorderThickness="1"
                                    Click="OnPvpClicked"
                                    Content="PVP"
                                    FontWeight="Bold" />
                                <Button
                                    x:Name="PveButton"
                                    Grid.Column="1"
                                    MinWidth="64"
                                    Padding="12,8"
                                    BorderThickness="1"
                                    Click="OnPveClicked"
                                    Content="PVE"
                                    FontWeight="Bold" />
                            </Grid>
                        </Border>

                        <StackPanel
                            x:Name="FilterGroup"
                            Grid.Column="2"
                            VerticalAlignment="Bottom"
                            Orientation="Horizontal"
                            Spacing="8">
                            <CheckBox
                                x:Name="TasksCheckBox"
                                VerticalAlignment="Center"
                                Checked="OnFilterChanged"
                                Content="任务"
                                Foreground="{StaticResource TrackerMutedBrush}"
                                IsChecked="True"
                                Unchecked="OnFilterChanged" />
                            <CheckBox
                                x:Name="HideoutCheckBox"
                                VerticalAlignment="Center"
                                Checked="OnFilterChanged"
                                Content="藏身处"
                                Foreground="{StaticResource TrackerMutedBrush}"
                                IsChecked="True"
                                Unchecked="OnFilterChanged" />
                        </StackPanel>

                        <StackPanel
                            x:Name="SortField"
                            Grid.Column="3"
                            Spacing="6">
                            <TextBlock
                                FontSize="13"
                                Foreground="{StaticResource TrackerMutedBrush}"
                                Text="排序" />
                            <ComboBox
                                x:Name="SortComboBox"
                                MinHeight="40"
                                Background="{StaticResource TrackerInputBrush}"
                                BorderBrush="{StaticResource TrackerLineBrush}"
                                Foreground="{StaticResource TrackerTextBrush}"
                                SelectionChanged="OnSortSelectionChanged">
                                <ComboBoxItem Content="默认" Tag="default" />
                                <ComboBoxItem Content="数量多到少" Tag="quantity-desc" />
                                <ComboBoxItem Content="数量少到多" Tag="quantity-asc" />
                                <ComboBoxItem Content="首字母 A-Z" Tag="name-asc" />
                                <ComboBoxItem Content="首字母 Z-A" Tag="name-desc" />
                            </ComboBox>
                        </StackPanel>

                        <Button
                            x:Name="RefreshButton"
                            Grid.Column="4"
                            MinWidth="96"
                            Padding="13,8"
                            VerticalAlignment="Bottom"
                            Background="#1D4A33"
                            BorderBrush="#5F856F"
                            BorderThickness="1"
                            Click="OnRefreshClicked"
                            Content="刷新清单"
                            Foreground="{StaticResource TrackerTextBrush}" />
                    </Grid>

                    <StackPanel
                        Grid.Row="1"
                        Orientation="Horizontal"
                        Spacing="12">
                        <TextBlock
                            x:Name="StatusText"
                            FontFamily="Cascadia Mono, Consolas"
                            Foreground="{StaticResource TrackerMutedBrush}"
                            Text="清单状态: 未加载" />
                        <TextBlock
                            x:Name="CountText"
                            FontFamily="Cascadia Mono, Consolas"
                            Foreground="{StaticResource TrackerMutedBrush}"
                            Text="0 个物品" />
                        <TextBlock
                            x:Name="TotalsText"
                            FontFamily="Cascadia Mono, Consolas"
                            Foreground="{StaticResource TrackerMutedBrush}"
                            Text="还差 0" />
                    </StackPanel>

                    <Grid Grid.Row="2">
                        <Border
                            x:Name="EmptyView"
                            MinHeight="120"
                            Background="#7008121A"
                            BorderBrush="#D04C6F82"
                            BorderThickness="1"
                            CornerRadius="10">
                            <TextBlock
                                x:Name="EmptyText"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Foreground="{StaticResource TrackerMutedBrush}"
                                Text="打开清单后会自动汇总任务与藏身处需求。"
                                TextAlignment="Center"
                                TextWrapping="WrapWholeWords" />
                        </Border>

                        <Grid
                            x:Name="ResultsView"
                            RowSpacing="10"
                            Visibility="Collapsed">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <ItemsRepeater
                                x:Name="TrackerResultsRepeater"
                                Grid.Row="0"
                                ItemTemplate="{StaticResource TrackerItemTemplate}"
                                ItemsSource="{x:Bind VisibleItems, Mode=OneWay}">
                                <ItemsRepeater.Layout>
                                    <UniformGridLayout
                                        x:Name="ResultsLayout"
                                        ItemsStretch="Fill"
                                        MinColumnSpacing="12"
                                        MinItemWidth="380"
                                        MinRowSpacing="12" />
                                </ItemsRepeater.Layout>
                            </ItemsRepeater>
                        </Grid>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </ScrollViewer>
</UserControl>
