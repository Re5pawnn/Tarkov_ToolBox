<?xml version="1.0" encoding="UTF-8" ?>
<Page
    x:Class="TarkovMapLocator.App.Views.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:TarkovMapLocator.App.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:TarkovMapLocator.App"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">
    <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <CommandBar
            x:Name="ModeBar"
            Grid.Row="0"
            DefaultLabelPosition="Right"
            IsOpen="False"
            Visibility="Collapsed">
            <AppBarButton
                x:Name="NativeMapModeButton"
                AutomationProperties.Name="地图"
                Icon="Map"
                Label="地图"
                Click="OnNativeMapModeClicked" />
            <AppBarButton
                x:Name="MarketModeButton"
                AutomationProperties.Name="跳蚤市场价格"
                Label="跳蚤市场价格"
                Click="OnMarketModeClicked" />
            <AppBarButton
                x:Name="TrackerModeButton"
                AutomationProperties.Name="任务物品清单"
                Label="任务物品清单"
                Click="OnTrackerModeClicked" />
        </CommandBar>

        <controls:MapCanvasControl
            x:Name="NativeMapPrototype"
            AutomationProperties.Name="地图"
            Grid.Row="1"
            Visibility="Collapsed" />

        <controls:FleaMarketControl
            x:Name="NativeMarket"
            AutomationProperties.Name="跳蚤市场价格"
            Grid.Row="1"
            Visibility="Collapsed" />

        <controls:TaskItemChecklistControl
            x:Name="NativeTracker"
            AutomationProperties.Name="任务物品清单"
            Grid.Row="1"
            Visibility="Collapsed" />
        <Grid
            x:Name="LoadingView"
            Grid.RowSpan="2"
            Padding="24">
            <StackPanel
                MaxWidth="520"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Spacing="16">
                <ProgressRing
                    Width="36"
                    Height="36"
                    IsActive="True" />
                <TextBlock
                    HorizontalAlignment="Center"
                    FontSize="20"
                    FontWeight="SemiBold"
                    Text="正在启动 TarkovMapLocator" />
                <TextBlock
                    x:Name="StatusText"
                    HorizontalAlignment="Center"
                    Text="正在启动本地后端服务..."
                    TextAlignment="Center"
                    TextWrapping="WrapWholeWords" />
            </StackPanel>
        </Grid>
    </Grid>
</Page>
