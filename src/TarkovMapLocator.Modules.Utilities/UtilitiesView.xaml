<UserControl x:Class="TarkovMapLocator.Modules.Utilities.UtilitiesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#101514"
             FontFamily="Microsoft YaHei UI">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="88" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <Grid Margin="24,20,24,16">
      <StackPanel VerticalAlignment="Bottom">
        <TextBlock Text="UTILITY HUB" Style="{StaticResource SectionLabel}" />
        <TextBlock Text="小工具"
                   Margin="0,3,0,0"
                   Foreground="{StaticResource TextBrush}"
                   FontSize="28"
                   FontWeight="Bold" />
      </StackPanel>
    </Grid>

    <ScrollViewer Grid.Row="1"
                  VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
      <UniformGrid Columns="4" Margin="16,0,16,8" VerticalAlignment="Top">
        <Button Tag="utilities/cultist-circle"
                Height="190" Margin="8,0,8,16" VerticalAlignment="Top"
                Style="{StaticResource TacticalButton}"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource LineBrightBrush}"
                BorderThickness="1" Click="FeatureButton_Click">
          <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
            <TextBlock Text="⌁" Foreground="{StaticResource AmberBrush}" FontSize="30" HorizontalAlignment="Center" />
            <TextBlock Text="邪教圈配方" Foreground="{StaticResource TextBrush}" FontSize="14" FontWeight="SemiBold" Margin="0,8,0,0" />
          </StackPanel>
        </Button>
        <Button Tag="utilities/season-documents"
                Height="190" Margin="8,0,8,16" VerticalAlignment="Top"
                Style="{StaticResource TacticalButton}"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource LineBrightBrush}"
                BorderThickness="1" Click="FeatureButton_Click">
          <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
            <TextBlock Text="▤" Foreground="{StaticResource CyanBrush}" FontSize="30" HorizontalAlignment="Center" />
            <TextBlock Text="赛季文档刷新位置" Foreground="{StaticResource TextBrush}" FontSize="14" FontWeight="SemiBold" Margin="0,8,0,0" />
          </StackPanel>
        </Button>
        <Button Tag="utilities/hideout-profit"
                Height="190" Margin="8,0,8,16" VerticalAlignment="Top"
                Style="{StaticResource TacticalButton}"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource LineBrightBrush}"
                BorderThickness="1" Click="FeatureButton_Click">
          <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
            <TextBlock Text="₽" Foreground="{StaticResource GreenBrush}" FontSize="30" FontWeight="Bold" HorizontalAlignment="Center" />
            <TextBlock Text="藏身处利润" Foreground="{StaticResource TextBrush}" FontSize="14" FontWeight="SemiBold" Margin="0,8,0,0" />
          </StackPanel>
        </Button>
        <Button Tag="utilities/story-guide"
                Height="190" Margin="8,0,8,16" VerticalAlignment="Top"
                Style="{StaticResource TacticalButton}"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource LineBrightBrush}"
                BorderThickness="1" Click="FeatureButton_Click">
          <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
            <TextBlock Text="◇" Foreground="{StaticResource AmberBrush}" FontSize="32" HorizontalAlignment="Center" />
            <TextBlock Text="剧情攻略" Foreground="{StaticResource TextBrush}" FontSize="14" FontWeight="SemiBold" Margin="0,8,0,0" />
          </StackPanel>
        </Button>
      </UniformGrid>
    </ScrollViewer>
  </Grid>
</UserControl>
