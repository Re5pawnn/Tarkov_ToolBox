<UserControl x:Class="TarkovMapLocator.Modules.Utilities.CultistCircle.CultistCircleView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:TarkovMapLocator.Modules.Utilities.Controls"
             Background="#101514"
             FontFamily="Microsoft YaHei UI">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="88" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>
    <Grid Margin="24,20,24,16">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="16" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <Button Width="72" Height="34" Padding="12,0" VerticalAlignment="Bottom"
              Style="{StaticResource TacticalButton}" Click="Back_Click">← 返回</Button>
      <StackPanel Grid.Column="2" VerticalAlignment="Bottom">
        <TextBlock Text="UTILITY HUB" Style="{StaticResource SectionLabel}" />
        <TextBlock Text="邪教圈配方" Margin="0,3,0,0" Foreground="{StaticResource TextBrush}" FontSize="28" FontWeight="Bold" />
        <TextBlock Text="所有配方均为一次性" Foreground="{StaticResource TextFaintBrush}" FontSize="11" Margin="0,3,0,0" />
      </StackPanel>
    </Grid>
    <Border Grid.Row="1" Height="36" Margin="24,0" BorderBrush="{StaticResource LineBrightBrush}"
            BorderThickness="1" Background="#111715" CornerRadius="7">
      <Grid Margin="10,0">
        <Grid.ColumnDefinitions><ColumnDefinition Width="19" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
        <TextBlock Text="⌕" Foreground="{StaticResource TextFaintBrush}" FontSize="15" VerticalAlignment="Center" />
        <TextBox Grid.Column="1" x:Name="SearchBox" TextChanged="SearchBox_TextChanged"
                 Background="Transparent" BorderThickness="0" Foreground="{StaticResource TextBrush}"
                 CaretBrush="{StaticResource AmberBrush}" FontSize="12" Padding="0"
                 VerticalContentAlignment="Center" ToolTip="搜索祭品或奖励" />
      </Grid>
    </Border>
    <TextBlock Grid.Row="2" x:Name="StatusText" Foreground="{StaticResource TextFaintBrush}" FontSize="11" Margin="24,10,24,9" />
    <Border Grid.Row="3" Margin="24,0,24,24" Background="#111715" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="10">
      <Grid>
        <ListBox x:Name="ResultsList" Background="Transparent" BorderThickness="0" Padding="12"
                 ItemContainerStyle="{StaticResource CardListItem}" ScrollViewer.VerticalScrollBarVisibility="Auto"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled" VirtualizingPanel.IsVirtualizing="True"
                 VirtualizingPanel.VirtualizationMode="Recycling" VirtualizingPanel.ScrollUnit="Pixel">
          <ListBox.ItemsPanel><ItemsPanelTemplate><VirtualizingStackPanel /></ItemsPanelTemplate></ListBox.ItemsPanel>
          <ListBox.ItemTemplate>
            <DataTemplate>
              <Border Background="#151C19" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,9">
                <StackPanel>
                  <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding Title}" Foreground="{StaticResource TextBrush}" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="14,0,0,0" VerticalAlignment="Center">
                      <Border Background="#242B27" CornerRadius="8" Padding="7,3"><TextBlock Foreground="{StaticResource TextDimBrush}" FontSize="10"><Run Text="{Binding DurationMinutes}" /><Run Text=" 分钟" /></TextBlock></Border>
                      <Border Margin="6,0,0,0" Background="#2A251A" CornerRadius="8" Padding="7,3"><Border.Style><Style TargetType="Border"><Setter Property="Visibility" Value="Visible" /><Style.Triggers><DataTrigger Binding="{Binding IsNew}" Value="False"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers></Style></Border.Style><TextBlock Text="近期新增" Foreground="{StaticResource AmberBrush}" FontSize="10" /></Border>
                      <Border Margin="6,0,0,0" Background="#27201F" CornerRadius="8" Padding="7,3"><Border.Style><Style TargetType="Border"><Setter Property="Visibility" Value="Visible" /><Style.Triggers><DataTrigger Binding="{Binding Restriction}" Value=""><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers></Style></Border.Style><TextBlock Text="{Binding Restriction}" Foreground="{StaticResource DangerBrush}" FontSize="10" /></Border>
                    </StackPanel>
                  </Grid>
                  <Grid Margin="0,13,0,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="54" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <Border Background="#111715" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="7" Padding="11">
                      <StackPanel>
                        <TextBlock Text="投入祭品" Foreground="{StaticResource AmberBrush}" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,7" />
                        <ItemsControl ItemsSource="{Binding Inputs}">
                          <ItemsControl.ItemTemplate><DataTemplate><Grid Margin="0,3"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><controls:ModuleItemIcon ItemId="{Binding Id}" IconLink="{Binding IconLink}" Width="46" Height="46" Margin="0,0,9,0" /><StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="{Binding Name}" Foreground="{StaticResource TextBrush}" FontSize="11" FontWeight="SemiBold" TextWrapping="Wrap" /><TextBlock Text="{Binding EnglishName}" Foreground="{StaticResource TextFaintBrush}" FontSize="9" Margin="0,3,0,0" TextWrapping="Wrap" /></StackPanel><TextBlock Grid.Column="2" Foreground="{StaticResource TextDimBrush}" FontFamily="Cascadia Mono" FontSize="12" FontWeight="Bold" VerticalAlignment="Center" Margin="8,0,0,0"><Run Text="×" /><Run Text="{Binding Count}" /></TextBlock></Grid></DataTemplate></ItemsControl.ItemTemplate>
                        </ItemsControl>
                      </StackPanel>
                    </Border>
                    <TextBlock Grid.Column="1" Text="→" Foreground="{StaticResource AmberBrush}" FontSize="24" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    <Border Grid.Column="2" Background="#111715" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="7" Padding="11">
                      <StackPanel>
                        <TextBlock Text="奖励结果" Foreground="{StaticResource GreenBrush}" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,7" />
                        <ItemsControl ItemsSource="{Binding RewardGroups}">
                          <ItemsControl.ItemTemplate><DataTemplate><StackPanel><TextBlock Text="随机结果" Foreground="{StaticResource CyanBrush}" FontSize="9" Margin="0,3,0,2"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Visible" /><Style.Triggers><DataTrigger Binding="{Binding Random}" Value="False"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock><ItemsControl ItemsSource="{Binding Items}"><ItemsControl.ItemTemplate><DataTemplate><Grid Margin="0,3"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><controls:ModuleItemIcon ItemId="{Binding Id}" IconLink="{Binding IconLink}" Width="46" Height="46" Margin="0,0,9,0" /><StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="{Binding Name}" Foreground="{StaticResource TextBrush}" FontSize="11" FontWeight="SemiBold" TextWrapping="Wrap" /><TextBlock Text="{Binding EnglishName}" Foreground="{StaticResource TextFaintBrush}" FontSize="9" Margin="0,3,0,0" TextWrapping="Wrap" /></StackPanel><TextBlock Grid.Column="2" Foreground="{StaticResource TextDimBrush}" FontFamily="Cascadia Mono" FontSize="12" FontWeight="Bold" VerticalAlignment="Center" Margin="8,0,0,0"><Run Text="×" /><Run Text="{Binding Count}" /></TextBlock></Grid></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></DataTemplate></ItemsControl.ItemTemplate>
                        </ItemsControl>
                      </StackPanel>
                    </Border>
                  </Grid>
                </StackPanel>
              </Border>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
        <TextBlock x:Name="EmptyText" Text="没有符合条件的配方。" Visibility="Collapsed"
                   Foreground="{StaticResource TextFaintBrush}" FontSize="12" Margin="16" />
      </Grid>
    </Border>
  </Grid>
</UserControl>
