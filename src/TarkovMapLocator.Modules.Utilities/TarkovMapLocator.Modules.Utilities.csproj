<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>TarkovMapLocator.Modules.Utilities</AssemblyName>
    <RootNamespace>TarkovMapLocator.Modules.Utilities</RootNamespace>
    <Version>1.0.0</Version>
    <DebugType Condition="'$(Configuration)' == 'Release'">none</DebugType>
    <DebugSymbols Condition="'$(Configuration)' == 'Release'">false</DebugSymbols>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\TarkovMapLocator.ModuleContracts\TarkovMapLocator.ModuleContracts.csproj" />
    <None Include="module.json" />
    <InternalsVisibleTo Include="TarkovMapLocatorDesktop.RegressionTests" />
    <EmbeddedResource Include="assets\cultist-circle-recipes.json">
      <LogicalName>TarkovMapLocator.Modules.Utilities.Resources.CultistCircleRecipes.json</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="assets\season-document-locations.json">
      <LogicalName>TarkovMapLocator.Modules.Utilities.Resources.SeasonDocumentLocations.json</LogicalName>
    </EmbeddedResource>
  </ItemGroup>
</Project>
