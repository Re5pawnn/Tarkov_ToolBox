<UserControl x:Class="TarkovMapLocator.Modules.TeamSync.TeamSyncView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#101514"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">
  <Grid Background="#101514">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <Grid Margin="24,22,24,24">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <StackPanel>
          <TextBlock Text="TEAM SYNC" Style="{StaticResource SectionLabel}" />
          <TextBlock Text="队友位置共享" Style="{StaticResource PageTitle}" />
        </StackPanel>

        <Border Grid.Row="1" Margin="0,20,0,0" Padding="20" Background="#111715" BorderBrush="{StaticResource LineBrightBrush}" BorderThickness="1" CornerRadius="10">
          <StackPanel>
            <TextBlock Text="同步配置" Foreground="{StaticResource TextBrush}" FontSize="14" FontWeight="SemiBold" />
            <Grid Margin="0,14,0,0">
              <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="16" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
              <StackPanel>
                <TextBlock Text="身份" Foreground="{StaticResource TextFaintBrush}" FontSize="10" Margin="0,0,0,5" />
                <TextBox x:Name="NameBox" Style="{StaticResource FormTextBox}" MaxLength="24" LostFocus="TextBox_LostFocus" KeyDown="TextBox_KeyDown" />
              </StackPanel>
              <StackPanel Grid.Column="2">
                <TextBlock Text="标记颜色" Foreground="{StaticResource TextFaintBrush}" FontSize="10" Margin="0,0,0,5" />
                <ComboBox x:Name="ColorComboBox" Style="{StaticResource FormComboBox}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectionChanged="ColorComboBox_SelectionChanged" />
              </StackPanel>
            </Grid>

            <TextBlock Text="连接方式" Foreground="{StaticResource TextFaintBrush}" FontSize="10" Margin="0,16,0,5" />
            <StackPanel Orientation="Horizontal">
              <Button x:Name="HostButton" Style="{StaticResource PageActionButton}" Click="HostButton_Click">我是房主</Button>
              <Button x:Name="JoinButton" Style="{StaticResource PageActionButton}" MinWidth="104" Margin="8,0,0,0" Click="JoinButton_Click">我要加入队友</Button>
            </StackPanel>

            <StackPanel x:Name="RemoteEndpointPanel" Margin="0,16,0,0" Visibility="Collapsed">
              <TextBlock Text="房主地址" Foreground="{StaticResource TextFaintBrush}" FontSize="10" Margin="0,0,0,5" />
              <TextBox x:Name="RemoteEndpointBox" Style="{StaticResource FormTextBox}" MaxLength="128" ToolTip="例如 192.168.1.8:17428，或手机地图 HTTPS 地址" LostFocus="TextBox_LostFocus" KeyDown="TextBox_KeyDown" />
            </StackPanel>

            <StackPanel Margin="0,16,0,0">
              <TextBlock Text="房间密钥" Foreground="{StaticResource TextFaintBrush}" FontSize="10" Margin="0,0,0,5" />
              <PasswordBox x:Name="RoomKeyBox" Height="34" MaxLength="128" Padding="10,0" VerticalContentAlignment="Center"
                           Background="#101514" Foreground="{StaticResource TextBrush}" BorderBrush="{StaticResource LineBrightBrush}"
                           BorderThickness="1" ToolTip="房主和所有队友填写同一个至少 12 位的密钥"
                           LostFocus="TextBox_LostFocus" KeyDown="TextBox_KeyDown" />
              <TextBlock Text="房主和所有队友必须填写相同密钥；请通过可信渠道分享。" Foreground="{StaticResource TextFaintBrush}" FontSize="9" Margin="0,5,0,0" />
              <TextBlock Text="与手机地图共用同一个端口；公网连接只需一条 HTTPS 隧道。" Foreground="{StaticResource TextFaintBrush}" FontSize="9" Margin="0,3,0,0" />
            </StackPanel>

            <Border Height="1" Background="{StaticResource LineBrush}" Margin="0,18,0,14" />
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
              <Button x:Name="StartStopButton" Style="{StaticResource PageActionButton}" Click="StartStopButton_Click">开启房间</Button>
              <TextBlock Grid.Column="1" x:Name="EndpointText" Foreground="{StaticResource TextDimBrush}" FontFamily="Cascadia Mono" FontSize="11" Margin="12,0,0,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
            </Grid>
            <Grid Margin="0,13,0,0">
              <Grid.ColumnDefinitions><ColumnDefinition Width="7" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
              <Ellipse Width="5" Height="5" Fill="{StaticResource TextFaintBrush}" VerticalAlignment="Center" HorizontalAlignment="Left" />
              <TextBlock Grid.Column="1" x:Name="StatusText" Foreground="{StaticResource TextBrush}" FontSize="11" FontWeight="SemiBold" Margin="5,0,0,0" VerticalAlignment="Center" TextWrapping="Wrap" />
            </Grid>
            <TextBlock x:Name="ErrorText" Foreground="{StaticResource DangerBrush}" FontSize="10" Margin="0,5,0,0" TextWrapping="Wrap" Visibility="Collapsed" />
          </StackPanel>
        </Border>

        <Border Grid.Row="2" Margin="0,12,0,0" Padding="15" Background="#111715" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="10">
          <StackPanel>
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
              <TextBlock Text="在线队友" Foreground="{StaticResource TextBrush}" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" />
              <Border Grid.Column="1" MinWidth="38" Padding="8,3" Background="{StaticResource RaisedBrush}" CornerRadius="10" VerticalAlignment="Center">
                <TextBlock x:Name="PeerCountText" Foreground="{StaticResource TextDimBrush}" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Border>
            </Grid>
            <StackPanel x:Name="PeerPanel" Margin="0,10,0,0" />
            <TextBlock x:Name="PeerEmptyText" Text="暂无在线队友" Foreground="{StaticResource TextFaintBrush}" FontSize="11" Margin="0,9,0,0" />
          </StackPanel>
        </Border>
      </Grid>
    </ScrollViewer>
  </Grid>
</UserControl>
