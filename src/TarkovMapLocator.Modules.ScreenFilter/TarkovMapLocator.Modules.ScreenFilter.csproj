<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseSystemDrawing>true</UseSystemDrawing>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>TarkovMapLocator.Modules.ScreenFilter</AssemblyName>
    <RootNamespace>TarkovMapLocator.Modules.ScreenFilter</RootNamespace>
    <Version>1.0.0</Version>
    <DebugType Condition="'$(Configuration)' == 'Release'">none</DebugType>
    <DebugSymbols Condition="'$(Configuration)' == 'Release'">false</DebugSymbols>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\TarkovMapLocator.ModuleContracts\TarkovMapLocator.ModuleContracts.csproj" />
    <None Include="module.json" />
    <ScreenFilterNotice Include="ThirdParty\TarkovAutoShade\NOTICE.md;ThirdParty\TarkovAutoShade\LICENSE" />
    <InternalsVisibleTo Include="TarkovMapLocatorDesktop.RegressionTests" />
  </ItemGroup>
  <Target Name="CopyScreenFilterNotices" AfterTargets="Build">
    <Copy SourceFiles="@(ScreenFilterNotice)" DestinationFolder="$(TargetDir)" SkipUnchangedFiles="true" />
  </Target>
</Project>
