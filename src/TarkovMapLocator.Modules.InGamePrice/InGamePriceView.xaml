<UserControl x:Class="TarkovMapLocator.Modules.InGamePrice.InGamePriceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#101514" Foreground="{StaticResource TextBrush}"
             FontFamily="Microsoft YaHei UI">
  <UserControl.Resources>
    <Style x:Key="PageTitle" TargetType="TextBlock">
      <Setter Property="FontSize" Value="28" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="Margin" Value="0,3,0,0" />
      <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
    </Style>
    <Style x:Key="PageToolbarButton" TargetType="Button" BasedOn="{StaticResource TacticalButton}">
      <Setter Property="Height" Value="36" />
      <Setter Property="MinWidth" Value="54" />
      <Setter Property="Padding" Value="12,0" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
  </UserControl.Resources>
  <Grid>
    <Grid.RowDefinitions><RowDefinition Height="104" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
    <Grid Margin="24,20,24,16">
      <StackPanel VerticalAlignment="Bottom"><TextBlock Text="AUTO OCR · TEST" Style="{StaticResource SectionLabel}" /><TextBlock Text="自动 OCR 查价（测试版）" Style="{StaticResource PageTitle}" /></StackPanel>
    </Grid>
    <Border Grid.Row="1" Margin="24,0,24,0" Padding="10,9" Background="#111715" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="8">
      <WrapPanel>
        <Button x:Name="InGamePricePagePvpButton" Style="{StaticResource PageToolbarButton}" Click="InGamePricePvp_Click">PVP</Button>
        <Button x:Name="InGamePricePagePveButton" Style="{StaticResource PageToolbarButton}" Margin="7,0,0,0" Click="InGamePricePve_Click">PVE</Button>
        <Button x:Name="InGamePricePagePvpSeasonButton" Style="{StaticResource PageToolbarButton}" Margin="7,0,0,0" Click="InGamePricePvpSeason_Click">赛季服</Button>
        <Button x:Name="InGamePricePageRecognitionButton" Style="{StaticResource PageToolbarButton}" Margin="12,0,0,0" Click="InGamePriceRecognition_Click">启动自动识别</Button>
        <Button x:Name="InGamePriceAutoRepairButton" Style="{StaticResource PageToolbarButton}" Margin="7,0,0,0" Click="InGamePriceAutoRepair_Click" ToolTip="清除固定识别区域及旧版定位记录，恢复为鼠标附近自动扫描">自动修复</Button>
        <Button x:Name="InGamePriceDebugButton" Style="{StaticResource PageToolbarButton}" Margin="7,0,0,0" Click="InGamePriceDebug_Click">查看定位画面</Button>
        <Button x:Name="InGamePriceWindowedDebugButton" Style="{StaticResource PageToolbarButton}" Margin="7,0,0,0" Click="InGamePriceWindowedDebug_Click">窗口化定位画面</Button>
        <Button x:Name="InGamePricePageCaptureAreaButton" Style="{StaticResource PageToolbarButton}" Margin="12,0,0,0" Click="InGamePriceCaptureArea_Click" ToolTip="框选一块固定的识别区域；识别只扫这块区域，不再跟随鼠标">识别区域</Button>
        <Button x:Name="InGamePricePageClearAreaButton" Style="{StaticResource PageToolbarButton}" Margin="7,0,0,0" Click="InGamePriceClearArea_Click" ToolTip="清除固定识别区域，恢复为跟随鼠标扫描">清除区域</Button>
      </WrapPanel>
    </Border>
    <Border Grid.Row="2" Margin="24,10,24,10" Padding="11,9" Background="#131A17" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="8">
      <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><Ellipse Width="7" Height="7" Fill="{StaticResource AmberBrush}" VerticalAlignment="Center" /><TextBlock Grid.Column="1" x:Name="InGamePricePageStatusText" Foreground="{StaticResource TextDimBrush}" FontSize="11" VerticalAlignment="Center" Margin="9,0,0,0" TextTrimming="CharacterEllipsis" /></Grid>
    </Border>
    <Border Grid.Row="3" Margin="24,0,24,24" Padding="14" Background="#111715" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="10" ClipToBounds="True">
      <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <Grid>
          <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
          <StackPanel><TextBlock Text="自动定位画面（高级反馈）" Foreground="{StaticResource TextBrush}" FontSize="14" FontWeight="SemiBold" /><TextBlock x:Name="InGamePriceDebugStatusText" Foreground="{StaticResource TextFaintBrush}" FontSize="10" Margin="0,4,0,0" /><TextBlock x:Name="InGamePriceDebugShortcutText" Foreground="{StaticResource AmberBrush}" FontSize="10" Margin="0,3,0,0" /></StackPanel>
          <TextBlock Grid.Column="1" Text="红：物品标题　绿：重量 kg　蓝：悬浮价签" Foreground="{StaticResource TextDimBrush}" FontSize="10" VerticalAlignment="Center" TextAlignment="Right" />
        </Grid>
        <Border Grid.Row="1" Margin="0,12,0,10" Background="#0C100F" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="7" ClipToBounds="True">
          <Grid x:Name="InGamePriceDebugViewport" Background="#0C100F" ClipToBounds="True" SizeChanged="InGamePriceDebugViewport_SizeChanged" MouseDown="InGamePriceDebugViewport_MouseDown" MouseMove="InGamePriceDebugViewport_MouseMove" MouseUp="InGamePriceDebugViewport_MouseUp" MouseWheel="InGamePriceDebugViewport_MouseWheel" LostMouseCapture="InGamePriceDebugViewport_LostMouseCapture">
            <Canvas x:Name="InGamePriceDebugTransformHost" HorizontalAlignment="Left" VerticalAlignment="Top" RenderTransformOrigin="0,0">
              <Canvas.RenderTransform><TransformGroup><ScaleTransform x:Name="InGamePriceDebugScaleTransform" ScaleX="1" ScaleY="1" /><TranslateTransform x:Name="InGamePriceDebugTranslateTransform" X="0" Y="0" /></TransformGroup></Canvas.RenderTransform>
              <Image x:Name="InGamePriceDebugImage" Stretch="None" SnapsToDevicePixels="True" IsHitTestVisible="False" />
              <Canvas x:Name="InGamePriceDebugOverlayCanvas" Background="Transparent" IsHitTestVisible="False" />
            </Canvas>
            <TextBlock x:Name="InGamePriceDebugEmptyText" Text="启动自动识别后，会显示鼠标附近的定位画面。它只用于确认 PP-OCR 是否找到了物品信息；可滚轮缩放、在空白处拖动平移，无需调框。" Foreground="{StaticResource TextFaintBrush}" FontSize="12" TextWrapping="Wrap" TextAlignment="Center" Width="440" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False" />
          </Grid>
        </Border>
        <TextBlock Grid.Row="2" Text="这张画面只用于测试反馈：自动模式不使用模板或 OCR 框。若连续识别不到，请先点“自动修复”恢复鼠标附近扫描；只有想固定扫描一块区域时才使用“识别区域”。仍失败时再截图反馈此画面。调试图只在本机内存中生成，不会写入截图目录。" Foreground="{StaticResource TextFaintBrush}" FontSize="10" TextWrapping="Wrap" />
      </Grid>
    </Border>
  </Grid>
</UserControl>
