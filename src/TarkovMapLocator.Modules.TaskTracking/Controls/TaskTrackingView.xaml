<UserControl x:Class="TarkovMapLocator.Modules.TaskTracking.Controls.TaskTrackingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:TarkovMapLocator.Modules.TaskTracking.Controls"
             Background="#101514"
             Foreground="{StaticResource TextBrush}"
             FontFamily="Microsoft YaHei UI">
  <Grid Margin="24,18,24,24">
    <Grid.RowDefinitions>
      <RowDefinition Height="58" />
      <RowDefinition Height="44" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <Grid>
      <StackPanel VerticalAlignment="Center">
        <TextBlock Text="TASK TRACKING" Style="{StaticResource SectionLabel}" />
        <TextBlock Text="任务追踪" Foreground="{StaticResource TextBrush}" FontSize="28" FontWeight="Bold" Margin="0,0,0,0" />
      </StackPanel>
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
        <CheckBox x:Name="AutomaticTaskRecognitionCheckBox" Content="自动识别任务" Foreground="{StaticResource TextDimBrush}" FontSize="11" VerticalAlignment="Center" Margin="0,0,10,0" IsChecked="True" Checked="AutomaticTaskRecognitionCheckBox_Changed" Unchecked="AutomaticTaskRecognitionCheckBox_Changed" />
        <CheckBox x:Name="AutoCompletePrerequisitesCheckBox" Content="自动补全前置任务" Foreground="{StaticResource TextDimBrush}" FontSize="11" VerticalAlignment="Center" Margin="0,0,10,0" IsChecked="True" Checked="AutoCompletePrerequisitesCheckBox_Changed" Unchecked="AutoCompletePrerequisitesCheckBox_Changed" />
        <Button x:Name="SyncTaskStatusButton" Style="{StaticResource TacticalButton}" Height="30" Padding="12,0" Content="立即同步" Click="SyncTaskStatusButton_Click" />
        <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
          <TextBlock x:Name="ProgressText" Foreground="{StaticResource TextDimBrush}" FontSize="11" HorizontalAlignment="Right" />
        </StackPanel>
      </StackPanel>
    </Grid>

    <Border Grid.Row="1" Background="#111715" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="8" Padding="8,4">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="110" />
          <ColumnDefinition Width="12" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="220" />
          <ColumnDefinition Width="12" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <TextBlock Text="模式" Foreground="{StaticResource TextFaintBrush}" FontSize="10" VerticalAlignment="Center" Margin="4,0,8,0" />
        <ComboBox Grid.Column="1" x:Name="TaskModeComboBox" Height="30" Style="{StaticResource DarkComboBox}" DisplayMemberPath="Name" SelectionChanged="TaskModeComboBox_SelectionChanged" />
        <TextBlock Grid.Column="3" Text="商人" Foreground="{StaticResource TextFaintBrush}" FontSize="10" VerticalAlignment="Center" Margin="4,0,8,0" />
        <ComboBox Grid.Column="4" x:Name="TraderComboBox" Height="30" Style="{StaticResource DarkComboBox}" DisplayMemberPath="Label" SelectionChanged="TraderComboBox_SelectionChanged" />
        <Border Grid.Column="6" Height="30" BorderBrush="{StaticResource LineBrightBrush}" BorderThickness="1" Background="#0E1412" CornerRadius="6">
          <Grid Margin="9,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="18" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <TextBlock Text="⌕" Foreground="{StaticResource TextFaintBrush}" VerticalAlignment="Center" />
            <TextBox Grid.Column="1" x:Name="SearchBox" Background="Transparent" BorderThickness="0" Foreground="{StaticResource TextBrush}" CaretBrush="{StaticResource AmberBrush}" VerticalContentAlignment="Center" FontSize="11" TextChanged="SearchBox_TextChanged" KeyDown="SearchBox_KeyDown" />
          </Grid>
        </Border>
        <StackPanel Grid.Column="7" Orientation="Horizontal" Margin="10,0,0,0">
          <Button Style="{StaticResource TacticalButton}" Width="32" Height="30" Content="−" Click="ZoomOutButton_Click" />
          <Button Style="{StaticResource TacticalButton}" Height="30" Padding="10,0" Margin="5,0" Content="复位" Click="ResetViewButton_Click" />
          <Button Style="{StaticResource TacticalButton}" Width="32" Height="30" Content="+" Click="ZoomInButton_Click" />
        </StackPanel>
      </Grid>
    </Border>

    <Grid Grid.Row="2" Margin="0,10,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="310" />
        <ColumnDefinition Width="10" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

      <Border Background="#111715" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="9" Padding="15">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <StackPanel>
            <TextBlock x:Name="DetailTraderText" Foreground="{StaticResource AmberBrush}" FontSize="12" />
            <TextBlock x:Name="DetailNameText" Text="选择一个任务" Foreground="White" FontSize="23" FontWeight="Bold" TextWrapping="Wrap" Margin="0,6,0,0" />
            <TextBlock x:Name="DetailLevelText" Foreground="{StaticResource TextFaintBrush}" FontSize="12" Margin="0,7,0,0" />
          </StackPanel>
          <Border Grid.Row="1" Height="1" Background="{StaticResource LineBrush}" Margin="0,13,0,13" />
          <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <ItemsControl x:Name="ObjectiveItems">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Grid Margin="0,0,5,11">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="12" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <Ellipse Width="6" Height="6" Fill="{StaticResource AmberBrush}" VerticalAlignment="Top" Margin="0,8,0,0" />
                    <TextBlock Grid.Column="1" Text="{Binding}" Foreground="{StaticResource TextDimBrush}" FontSize="13.5" LineHeight="22" TextWrapping="Wrap" />
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
          <StackPanel Grid.Row="3" Margin="0,12,0,0">
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
              <Button x:Name="NotStartedButton" Style="{StaticResource TacticalButton}" Height="33" Content="未接取" Click="NotStartedButton_Click" IsEnabled="False" />
              <Button Grid.Column="1" x:Name="AcceptedButton" Style="{StaticResource TacticalButton}" Height="33" Content="进行中" Margin="6,0" Click="AcceptedButton_Click" IsEnabled="False" />
              <Button Grid.Column="2" x:Name="CompletedButton" Style="{StaticResource TacticalButton}" Height="33" Content="已完成" Click="CompletedButton_Click" IsEnabled="False" />
            </Grid>
            <Grid Margin="0,7,0,0">
              <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
              <Button x:Name="PinTaskButton" Style="{StaticResource TacticalButton}" Height="32" Content="标记任务" Click="PinTaskButton_Click" IsEnabled="False" />
              <Button Grid.Column="1" x:Name="OverlayResizeButton" Style="{StaticResource TacticalButton}" Height="32" Content="调整框体" Margin="6,0,0,0" Click="OverlayResizeButton_Click" IsEnabled="False" />
              <Button Grid.Column="2" x:Name="OpenWikiButton" Style="{StaticResource TacticalButton}" Height="32" Content="查看攻略" Margin="6,0,0,0" Click="OpenWikiButton_Click" IsEnabled="False" />
            </Grid>
            <CheckBox x:Name="LinkTaskPointsCheckBox" Content="标记任务时同步地图任务点位" Foreground="{StaticResource TextDimBrush}" FontSize="11" Margin="1,10,0,0" Checked="LinkTaskPointsCheckBox_Changed" Unchecked="LinkTaskPointsCheckBox_Changed" />
          </StackPanel>
        </Grid>
      </Border>

      <Border Grid.Column="2" Background="#0D1210" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="9" ClipToBounds="True" UseLayoutRounding="True" SnapsToDevicePixels="True">
        <Grid>
          <ScrollViewer x:Name="TaskGraphViewport" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" CanContentScroll="False" PanningMode="Both" PreviewMouseWheel="TaskGraphViewport_PreviewMouseWheel">
            <Grid x:Name="TaskGraphScaleHost" Background="#0D1210">
              <Canvas x:Name="TaskGraphCanvas" HorizontalAlignment="Left" VerticalAlignment="Top" Background="Transparent" UseLayoutRounding="True" SnapsToDevicePixels="True" RenderOptions.EdgeMode="Aliased" MouseLeftButtonDown="TaskGraphCanvas_MouseLeftButtonDown" MouseMove="TaskGraphCanvas_MouseMove" MouseLeftButtonUp="TaskGraphCanvas_MouseLeftButtonUp" LostMouseCapture="TaskGraphCanvas_LostMouseCapture" />
            </Grid>
          </ScrollViewer>
          <TextBlock x:Name="EmptyText" Text="正在读取任务树…" Foreground="{StaticResource TextFaintBrush}" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center" />
          <Border HorizontalAlignment="Right" VerticalAlignment="Top" Margin="12" Padding="8,5" Background="#D9141B18" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="6" IsHitTestVisible="False">
            <TextBlock x:Name="ZoomText" Text="100%" Foreground="{StaticResource TextDimBrush}" FontFamily="Cascadia Mono" FontSize="10" />
          </Border>
        </Grid>
      </Border>
    </Grid>

    <local:TaskTrackingDetailView x:Name="TaskDetailView" Grid.RowSpan="3" Panel.ZIndex="50" Visibility="Collapsed" />
  </Grid>
</UserControl>
