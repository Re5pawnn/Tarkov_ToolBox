<UserControl x:Class="TarkovMapLocator.Modules.TaskTracking.Controls.TaskTrackingDetailView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#101514"
             Foreground="{StaticResource TextBrush}"
             FontFamily="Microsoft YaHei UI">
  <Grid Background="#101514">
    <Grid.RowDefinitions>
      <RowDefinition Height="64" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1" Padding="24,0">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Button Style="{StaticResource TacticalButton}" Height="34" Padding="13,0" Content="← 返回任务列表" Click="BackButton_Click" />
        <StackPanel Grid.Column="1" Margin="18,0" VerticalAlignment="Center">
          <TextBlock Text="TASK GUIDE" Style="{StaticResource SectionLabel}" />
          <TextBlock x:Name="PageTitleText" Text="任务详情" Foreground="White" FontSize="21" FontWeight="Bold" TextTrimming="CharacterEllipsis" />
        </StackPanel>
        <TextBlock Grid.Column="2" x:Name="PageStateText" Foreground="{StaticResource TextFaintBrush}" FontSize="11" VerticalAlignment="Center" />
      </Grid>
    </Border>

    <Grid Grid.Row="1">
      <ScrollViewer x:Name="DetailScrollViewer" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="26,22,30,36" MaxWidth="1180" HorizontalAlignment="Left">
          <Border Background="#111715" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="9" Padding="18">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="TaskImageColumn" Width="0" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <Border x:Name="TaskImageBorder" Width="290" Height="170" Margin="0,0,20,0" Background="#0B100F" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="7" Visibility="Collapsed" ClipToBounds="True">
                <Image x:Name="TaskImage" Stretch="UniformToFill" />
              </Border>
              <StackPanel Grid.Column="1">
                <TextBlock x:Name="MetaText" Foreground="{StaticResource AmberBrush}" FontSize="13" TextWrapping="Wrap" />
                <TextBlock x:Name="DescriptionText" Foreground="{StaticResource TextDimBrush}" FontSize="13" LineHeight="21" TextWrapping="Wrap" Margin="0,10,0,0" />
                <Grid Margin="0,16,0,0">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="16" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                  <StackPanel>
                    <TextBlock Text="前置任务" Foreground="White" FontSize="12" FontWeight="SemiBold" />
                    <WrapPanel x:Name="PreviousTasksPanel" Margin="0,8,0,0" />
                  </StackPanel>
                  <StackPanel Grid.Column="2">
                    <TextBlock Text="后续任务" Foreground="White" FontSize="12" FontWeight="SemiBold" />
                    <WrapPanel x:Name="NextTasksPanel" Margin="0,8,0,0" />
                  </StackPanel>
                </Grid>
              </StackPanel>
            </Grid>
          </Border>

          <Border Margin="0,14,0,0" Background="#111715" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="9" Padding="18">
            <StackPanel>
              <TextBlock Text="任务目标" Foreground="White" FontSize="18" FontWeight="Bold" />
              <StackPanel x:Name="ObjectivesPanel" Margin="0,12,0,0" />
            </StackPanel>
          </Border>

          <Border x:Name="GuideSection" Margin="0,14,0,0" Background="#111715" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="9" Padding="18">
            <StackPanel>
              <TextBlock Text="任务攻略" Foreground="White" FontSize="18" FontWeight="Bold" />
              <StackPanel x:Name="GuidePanel" Margin="0,12,0,0" />
            </StackPanel>
          </Border>

          <Border x:Name="NeededKeysSection" Margin="0,14,0,0" Background="#111715" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="9" Padding="18" Visibility="Collapsed">
            <StackPanel>
              <TextBlock Text="所需钥匙" Foreground="White" FontSize="18" FontWeight="Bold" />
              <StackPanel x:Name="NeededKeysPanel" Margin="0,12,0,0" />
            </StackPanel>
          </Border>

          <Border Margin="0,14,0,0" Background="#111715" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="9" Padding="18">
            <StackPanel>
              <TextBlock Text="任务奖励" Foreground="White" FontSize="18" FontWeight="Bold" />
              <StackPanel x:Name="RewardsPanel" Margin="0,12,0,0" />
            </StackPanel>
          </Border>
        </StackPanel>
      </ScrollViewer>

      <Border x:Name="LoadingPanel" Background="#E6101514" Visibility="Collapsed">
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
          <TextBlock Text="正在加载" Foreground="White" FontSize="15" HorizontalAlignment="Center" />
        </StackPanel>
      </Border>
    </Grid>
  </Grid>
</UserControl>
