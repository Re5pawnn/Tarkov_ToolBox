<Window x:Class="TarkovMapLocatorDesktop.Windows.MiniMapWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="420" Height="330" MinWidth="280" MinHeight="230"
        WindowStartupLocation="Manual" WindowStyle="None" ResizeMode="CanResize"
        Topmost="True" ShowInTaskbar="False"
        Background="{StaticResource CanvasBrush}"
        FontFamily="Microsoft YaHei UI" Foreground="{StaticResource TextBrush}">
  <Border Margin="1" BorderBrush="{StaticResource LineBrightBrush}" BorderThickness="1" CornerRadius="9" ClipToBounds="True">
    <Grid x:Name="MapHost" Background="#101514" ClipToBounds="True"
          SizeChanged="MapHost_SizeChanged" MouseWheel="MapHost_MouseWheel"
          MouseLeftButtonDown="MapHost_MouseLeftButtonDown" MouseMove="MapHost_MouseMove"
          MouseLeftButtonUp="MapHost_MouseLeftButtonUp" LostMouseCapture="MapHost_LostMouseCapture">
      <Grid x:Name="MiniMapContent" RenderTransformOrigin=".5,.5">
        <Grid.RenderTransform>
          <TransformGroup>
            <ScaleTransform x:Name="MiniMapScaleTransform" ScaleX="1" ScaleY="1" />
            <TranslateTransform x:Name="MiniMapTranslateTransform" X="0" Y="0" />
          </TransformGroup>
        </Grid.RenderTransform>
        <Image x:Name="MiniMapImage" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity=".93" />
        <Image x:Name="MiniMapLayerImage" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0" Visibility="Collapsed" IsHitTestVisible="False" />
      </Grid>
      <Canvas x:Name="MiniAirdropRayCanvas" IsHitTestVisible="False" />
      <Canvas x:Name="MiniMarkerCanvas" IsHitTestVisible="True" />
      <Canvas x:Name="MiniDynamicMarkerCanvas" IsHitTestVisible="True" />
      <Border x:Name="MiniMapDragHandle" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="10" Padding="7,4" CornerRadius="5" Background="#D9121816" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" Cursor="SizeAll" MouseLeftButtonDown="MiniMapDragHandle_MouseLeftButtonDown" ToolTip="拖动悬浮地图">
        <TextBlock x:Name="MapNameText" Text="等待地图" FontSize="11" FontWeight="SemiBold" />
      </Border>
      <Button x:Name="MiniMapLockButton" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,10,42,0" Width="24" Height="24" Padding="0" Content="锁" Style="{StaticResource IconButton}" ToolTip="锁定悬浮地图位置和尺寸" Click="MiniMapLock_Click" />
      <Button HorizontalAlignment="Right" VerticalAlignment="Top" Margin="10" Width="24" Height="24" Padding="0" Content="×" Style="{StaticResource IconButton}" ToolTip="关闭悬浮地图" Click="Close_Click" />
      <Border HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="10" Padding="7,4" CornerRadius="5" Background="#D9121816" BorderBrush="{StaticResource LineBrush}" BorderThickness="1">
        <StackPanel Orientation="Horizontal"><TextBlock Text="● 当前位置" Foreground="{StaticResource PlayerBrush}" FontSize="9" /><TextBlock Text="● 过期" Foreground="{StaticResource StalePlayerBrush}" FontSize="9" Margin="7,0,0,0" /><TextBlock Text="● 撤离" Foreground="{StaticResource GreenBrush}" FontSize="9" Margin="7,0,0,0" /><TextBlock Text="● 转移" Foreground="{StaticResource AmberBrush}" FontSize="9" Margin="7,0,0,0" /><TextBlock Text="● 钥匙" Foreground="{StaticResource KeyRoomBrush}" FontSize="9" Margin="7,0,0,0" /><TextBlock Text="● 拉闸" Foreground="{StaticResource SwitchBrush}" FontSize="9" Margin="7,0,0,0" /><TextBlock Text="● BTR" Foreground="#EAB308" FontSize="9" Margin="7,0,0,0" /><TextBlock Text="● 任务" Foreground="{StaticResource TaskBrush}" FontSize="9" Margin="7,0,0,0" /><TextBlock Text="⌖ 空投" Foreground="{StaticResource AirdropEstimateBrush}" FontSize="9" Margin="7,0,0,0" /></StackPanel>
      </Border>
    </Grid>
  </Border>
</Window>
