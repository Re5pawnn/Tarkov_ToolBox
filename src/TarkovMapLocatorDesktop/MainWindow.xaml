              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <TextBlock Text="显示内容" Foreground="{StaticResource TextDimBrush}" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" Margin="2,0,16,0" />
                <WrapPanel Grid.Column="1" VerticalAlignment="Center">
                  <CheckBox x:Name="ExtractPointDisplayCheck" Content="撤离点 / 转移点" IsChecked="True" Checked="PointDisplayCheckChanged" Unchecked="PointDisplayCheckChanged" Foreground="{StaticResource TextDimBrush}" FontSize="12" Margin="0,3,20,3" />
                  <CheckBox x:Name="TaskPointDisplayCheck" Content="已选任务点" IsChecked="True" Checked="PointDisplayCheckChanged" Unchecked="PointDisplayCheckChanged" Foreground="{StaticResource TextDimBrush}" FontSize="12" Margin="0,3,20,3" />
                  <CheckBox x:Name="KeyRoomPointDisplayCheck" Content="钥匙房 / 上锁点" IsChecked="False" Checked="PointDisplayCheckChanged" Unchecked="PointDisplayCheckChanged" Foreground="{StaticResource TextDimBrush}" FontSize="12" Margin="0,3,20,3" ToolTip="显示上锁房门、载具后备箱、上锁容器与机关；悬停可查看所需钥匙" />
