    <Grid x:Name="SettingsPage" Grid.Row="1" Grid.Column="2" Background="#101514" Visibility="Collapsed">
      <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="24,22,24,24">
          <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
          <StackPanel><TextBlock Text="LOCAL SETTINGS" Style="{StaticResource SectionLabel}" /><TextBlock Text="本机设置" Style="{StaticResource PageTitle}" /></StackPanel>
          <Border Grid.Row="1" x:Name="FirstRunSetupBorder" Margin="0,20,0,0" Padding="16" Background="#1E2118" BorderBrush="{StaticResource AmberBrush}" BorderThickness="1" CornerRadius="10" Visibility="Collapsed"><StackPanel><TextBlock Text="首次启动需要完成路径选择" Foreground="{StaticResource AmberBrush}" FontSize="12" FontWeight="SemiBold" /><TextBlock Text="请先选择截图目录和 Escape from Tarkov 的 Logs 目录。完成后地图监听会立即使用这些路径。" Foreground="{StaticResource TextDimBrush}" FontSize="10" TextWrapping="Wrap" Margin="0,6,0,0" /></StackPanel></Border>
          <Border Grid.Row="2" Margin="0,12,0,0" Padding="16" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource LineBrightBrush}" BorderThickness="1" CornerRadius="10"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel VerticalAlignment="Center"><TextBlock Text="坐标截图目录" Foreground="{StaticResource TextFaintBrush}" FontSize="10" /><TextBlock x:Name="SettingsScreenshotPathText" Text="尚未选择" FontSize="12" Margin="0,5,0,0" TextWrapping="Wrap" /><TextBlock x:Name="SettingsScreenshotStateText" Foreground="{StaticResource TextDimBrush}" FontSize="10" Margin="0,5,0,0" /><TextBlock Text="参考路径为 C:\Users\Administrator\Documents\Escape from Tarkov\Screenshots" Foreground="{StaticResource TextFaintBrush}" FontFamily="Cascadia Mono" FontSize="9" Margin="0,5,0,0" TextWrapping="Wrap" /></StackPanel><Button Grid.Column="1" Style="{StaticResource PageActionButton}" Content="选择目录" Margin="18,0,0,0" Click="ChooseScreenshotPath_Click" /></Grid></Border>
          <Border Grid.Row="3" Margin="0,10,0,0" Padding="16" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource LineBrightBrush}" BorderThickness="1" CornerRadius="10"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel VerticalAlignment="Center"><TextBlock Text="游戏日志目录" Foreground="{StaticResource TextFaintBrush}" FontSize="10" /><TextBlock x:Name="SettingsGameLogPathText" Text="尚未选择" FontSize="12" Margin="0,5,0,0" TextWrapping="Wrap" /><TextBlock x:Name="SettingsGameLogStateText" Foreground="{StaticResource TextDimBrush}" FontSize="10" Margin="0,5,0,0" /><TextBlock Text="参考路径为 D:\SteamLibrary\steamapps\common\Escape from Tarkov\build\Logs" Foreground="{StaticResource TextFaintBrush}" FontFamily="Cascadia Mono" FontSize="9" Margin="0,5,0,0" TextWrapping="Wrap" /></StackPanel><Button Grid.Column="1" Style="{StaticResource PageActionButton}" Content="选择目录" Margin="18,0,0,0" Click="ChooseGameLogPath_Click" /></Grid></Border>
          <Border Grid.Row="4" Margin="0,10,0,0" Padding="16" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource LineBrightBrush}" BorderThickness="1" CornerRadius="10">
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="210" /></Grid.ColumnDefinitions>
              <StackPanel VerticalAlignment="Center">
                <TextBlock Text="关闭行为" Foreground="{StaticResource TextBrush}" FontSize="14" FontWeight="SemiBold" />
                <TextBlock Text="标题栏 × 和任务栏右键“关闭”都会遵循此选项；可随时在这里改回。" Foreground="{StaticResource TextFaintBrush}" FontSize="10" Margin="0,5,0,0" TextWrapping="Wrap" />
                <TextBlock x:Name="CloseBehaviorStatusText" Foreground="{StaticResource TextDimBrush}" FontSize="10" Margin="0,7,0,0" />
              </StackPanel>
              <ComboBox Grid.Column="1" x:Name="CloseBehaviorComboBox" Height="32" Style="{StaticResource DarkComboBox}" SelectionChanged="CloseBehaviorComboBox_SelectionChanged" VerticalAlignment="Center" ToolTip="选择点击关闭时的默认行为">
                <ComboBoxItem Tag="ask">每次询问</ComboBoxItem>
                <ComboBoxItem Tag="minimize">关闭时最小化</ComboBoxItem>
                <ComboBoxItem Tag="exit">关闭时退出工具</ComboBoxItem>
              </ComboBox>
            </Grid>
          </Border>
          <Border Grid.Row="5" Margin="0,10,0,0" Padding="16" Background="#111715" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="10">
            <Grid>
              <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center"><TextBlock Text="运行日志" Foreground="{StaticResource TextBrush}" FontSize="14" FontWeight="SemiBold" /><TextBlock Text="记录地图监听、识别证据、坐标、行情、清单、屏幕调色与队友共享状态" Foreground="{StaticResource TextFaintBrush}" FontSize="10" Margin="0,4,0,0" /></StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><Button Style="{StaticResource TacticalButton}" Height="29" Padding="9,0" FontSize="10" Content="复制显示" Click="CopyRuntimeLog_Click" /><Button Style="{StaticResource TacticalButton}" Height="29" Padding="9,0" FontSize="10" Margin="7,0,0,0" Content="导出" Click="ExportRuntimeLog_Click" /><Button Style="{StaticResource TacticalButton}" Height="29" Padding="9,0" FontSize="10" Margin="7,0,0,0" Content="清空显示" Click="ClearRuntimeLog_Click" /><Button Style="{StaticResource TacticalButton}" Height="29" Padding="9,0" FontSize="10" Margin="7,0,0,0" Content="打开目录" Click="OpenRuntimeLogDirectory_Click" /></StackPanel>
              </Grid>
              <Grid Grid.Row="1" Margin="0,12,0,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="132" /><ColumnDefinition Width="188" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <ComboBox x:Name="RuntimeLogLevelFilterComboBox" Height="32" Style="{StaticResource DarkComboBox}" SelectedIndex="0" SelectionChanged="RuntimeLogFilter_Changed" ToolTip="按日志级别筛选"><ComboBoxItem Tag="all">全部级别</ComboBoxItem><ComboBoxItem Tag="trace">跟踪</ComboBoxItem><ComboBoxItem Tag="info">信息</ComboBoxItem><ComboBoxItem Tag="warning">警告</ComboBoxItem><ComboBoxItem Tag="error">错误</ComboBoxItem></ComboBox>
                <ComboBox Grid.Column="1" x:Name="RuntimeLogCategoryFilterComboBox" Height="32" Margin="8,0,0,0" Style="{StaticResource DarkComboBox}" SelectionChanged="RuntimeLogFilter_Changed" ToolTip="按功能模块筛选" />
                <Border Grid.Column="2" Height="32" Margin="8,0,0,0" BorderBrush="{StaticResource LineBrightBrush}" BorderThickness="1" Background="#0D1211" CornerRadius="6"><Grid Margin="9,0"><Grid.ColumnDefinitions><ColumnDefinition Width="18" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><TextBlock Text="⌕" Foreground="{StaticResource TextFaintBrush}" FontSize="15" VerticalAlignment="Center" /><TextBox Grid.Column="1" x:Name="RuntimeLogSearchBox" TextChanged="RuntimeLogFilter_Changed" Background="Transparent" BorderThickness="0" Foreground="{StaticResource TextBrush}" CaretBrush="{StaticResource AmberBrush}" FontSize="11" Padding="0" VerticalContentAlignment="Center" ToolTip="搜索模块、消息或详细信息；多个关键词需同时匹配" /></Grid></Border>
                <Button Grid.Column="3" x:Name="RuntimeLogAutoScrollButton" Style="{StaticResource TacticalButton}" Height="32" Padding="10,0" Margin="8,0,0,0" FontSize="10" Content="自动滚动：开" Click="ToggleRuntimeLogAutoScroll_Click" />
              </Grid>
              <Grid Grid.Row="2" Margin="0,10,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock x:Name="RuntimeLogSummaryText" Foreground="{StaticResource GreenBrush}" FontSize="10" /><TextBlock Grid.Column="1" x:Name="RuntimeLogRetentionText" Text="完整日志按天保存 · 保留 14 天" Foreground="{StaticResource TextFaintBrush}" FontSize="10" /></Grid>
              <TextBox Grid.Row="3" x:Name="RuntimeLogTextBox" Height="320" Margin="0,9,0,0" Padding="11,9" IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" Background="#0D1211" Foreground="{StaticResource TextBrush}" BorderBrush="{StaticResource LineBrightBrush}" BorderThickness="1" FontFamily="Cascadia Mono" FontSize="10" SelectionBrush="{StaticResource AmberBrush}" />
              <TextBlock Grid.Row="4" x:Name="RuntimeLogPathText" Margin="0,8,0,0" Foreground="{StaticResource TextFaintBrush}" FontFamily="Cascadia Mono" FontSize="9" TextTrimming="CharacterEllipsis" />
            </Grid>
          </Border>
          <Border Grid.Row="6" Margin="0,10,0,0" Padding="16" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource LineBrightBrush}" BorderThickness="1" CornerRadius="10">
            <StackPanel>
              <TextBlock Text="ABOUT" Style="{StaticResource SectionLabel}" />
              <TextBlock Text="关于作者" Foreground="{StaticResource TextBrush}" FontSize="14" FontWeight="SemiBold" Margin="0,4,0,0" />
              <TextBlock Text="qq交流群：975750836" Foreground="{StaticResource TextDimBrush}" FontSize="11" Margin="0,10,0,0" />
              <TextBlock Text="作者（小黑盒）：大狼吃药了 丨呆呆猫猫丨" Foreground="{StaticResource TextDimBrush}" FontSize="11" Margin="0,5,0,0" TextWrapping="Wrap" />
            </StackPanel>
          </Border>
        </Grid>
      </ScrollViewer>
    </Grid>

    <Grid x:Name="InspectorPaneHost" Grid.Row="1" Grid.Column="3" ClipToBounds="True">
      <Border x:Name="InspectorPane" HorizontalAlignment="Right" Background="#121716" BorderBrush="{StaticResource LineBrush}" BorderThickness="1,0,0,0" Padding="16,22,16,15">
        <Grid>
          <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
          <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <StackPanel><TextBlock Text="RAID STATUS" Style="{StaticResource SectionLabel}" /><TextBlock Text="本局状态" FontSize="20" FontWeight="SemiBold" Margin="0,3,0,0" /></StackPanel>
            <Button Grid.Column="1" x:Name="RaidStatusCollapseButton" Style="{StaticResource IconButton}" Width="30" Height="30" Padding="0" Content="‹" ToolTip="向左收起本局状态" Click="RaidStatusCollapseButton_Click" />
          </Grid>
          <Border x:Name="RaidStatusCardHost" Grid.Row="1" Margin="0,20,0,0" Padding="14" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource LineBrightBrush}" BorderThickness="1" CornerRadius="10">
            <Border.RenderTransform><TranslateTransform x:Name="RaidStatusCardTranslateTransform" /></Border.RenderTransform>
            <StackPanel>
              <Grid Margin="0,0,0,13">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Ellipse x:Name="ListeningStateDot" Width="6" Height="6" Fill="{StaticResource TextFaintBrush}" Margin="0,0,6,0" VerticalAlignment="Center" /><TextBlock x:Name="ListeningStateText" Text="未监听" Foreground="{StaticResource TextFaintBrush}" FontSize="10" FontWeight="SemiBold" VerticalAlignment="Center" /></StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center"><Button x:Name="ListeningButton" Style="{StaticResource TacticalButton}" Width="72" Height="30" Padding="4,0" FontSize="10" Click="ListeningButton_Click">开始监听</Button><Button x:Name="AutoRefreshButton" Style="{StaticResource TacticalButton}" Width="66" Height="30" Padding="4,0" FontSize="10" Margin="7,0,0,0" Click="AutoRefreshButton_Click">自动刷新</Button></StackPanel>
              </Grid>
              <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><StackPanel><TextBlock Text="当前地图" Foreground="{StaticResource TextFaintBrush}" FontSize="10" /><TextBlock Text="{Binding CurrentMapName}" FontSize="11" Margin="0,4,0,0" /></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="刷新间隔" Foreground="{StaticResource TextFaintBrush}" FontSize="10" /><TextBlock Text="2 秒" FontSize="11" Margin="0,4,0,0" /></StackPanel></Grid>
              <Border Height="1" Background="{StaticResource LineBrush}" Margin="0,11,0,10" />
              <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><TextBlock Text="最近更新" Foreground="{StaticResource TextFaintBrush}" FontSize="10" /><TextBlock Grid.Column="1" Text="{Binding LastUpdate}" FontSize="10" Margin="12,0,0,0" /></Grid>
            </StackPanel>
          </Border>
          <Border x:Name="TaskConfigPanel" Grid.Row="2" Margin="0,16,0,0" Padding="14" Background="#141A18" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="10">
            <Grid>
              <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="42" /><RowDefinition Height="*" /></Grid.RowDefinitions>
              <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel VerticalAlignment="Center"><TextBlock Text="TASK POINTS" Style="{StaticResource SectionLabel}" /><TextBlock x:Name="TaskMapNameText" Text="当前地图任务" FontSize="13" FontWeight="SemiBold" Margin="0,3,0,0" /></StackPanel><Button Grid.Column="1" Style="{StaticResource TacticalButton}" Height="30" Padding="9,0" Foreground="{StaticResource TextDimBrush}" FontSize="10" VerticalAlignment="Center" Click="ClearTaskSelection_Click"><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Viewbox Width="12" Height="12" Margin="0,0,5,0"><Canvas Width="24" Height="24"><Path Data="M4,6 H20 M9,6 V4 H15 V6 M6,6 L7,20 H17 L18,6 M10,10 V17 M14,10 V17" Fill="Transparent" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" /></Canvas></Viewbox><TextBlock Text="清空" VerticalAlignment="Center" /></StackPanel></Button></Grid>
              <TextBlock Grid.Row="1" x:Name="TaskSelectionSummaryText" Text="默认不显示任务点位" Foreground="{StaticResource TextFaintBrush}" FontSize="10" Margin="0,9,0,8" TextWrapping="Wrap" />
              <Border Grid.Row="2" Height="34" Margin="0,0,0,8" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" Background="#111715" CornerRadius="7"><Grid Margin="9,0"><Grid.ColumnDefinitions><ColumnDefinition Width="18" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><TextBlock Text="⌕" Foreground="{StaticResource TextFaintBrush}" FontSize="15" VerticalAlignment="Center" /><TextBox Grid.Column="1" x:Name="TaskSearchBox" TextChanged="TaskSearchBox_TextChanged" Background="Transparent" BorderThickness="0" Foreground="{StaticResource TextBrush}" CaretBrush="{StaticResource AmberBrush}" FontSize="11" Padding="0" VerticalContentAlignment="Center" ToolTip="搜索任务名称或目标说明" /></Grid></Border>
              <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel x:Name="TaskListPanel"><TextBlock x:Name="TaskEmptyText" Text="未找到当前地图的任务点数据" Foreground="{StaticResource TextFaintBrush}" FontSize="11" Margin="0,8" TextWrapping="Wrap" /></StackPanel></ScrollViewer>
            </Grid>
          </Border>
          <Border Grid.Row="3" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0" Padding="0,13,0,0"><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Ellipse Width="5" Height="5" Fill="{StaticResource GreenBrush}" Margin="0,0,7,0" VerticalAlignment="Center" /><TextBlock x:Name="MonitorStatusText" Text="运行状态：只读取本机文件" Foreground="{StaticResource TextFaintBrush}" FontSize="10" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" /></StackPanel></Border>
        </Grid>
      </Border>
    </Grid>

    <primitives:Thumb x:Name="MapTaskWidthSplitter" Grid.Row="1" Grid.Column="2"
                      Style="{StaticResource WorkbenchPaneSplitter}"
                      HorizontalAlignment="Right" Panel.ZIndex="70"
                      DragDelta="MapTaskWidthSplitter_DragDelta"
                      DragCompleted="MapTaskSplitter_DragCompleted"
                      ToolTip="拖动：调整地图与任务面板宽度" />
    <primitives:Thumb x:Name="MapTaskHeightSplitter" Grid.Row="1" Grid.Column="2"
                      Style="{StaticResource WorkbenchRowSplitter}"
                      VerticalAlignment="Bottom" Panel.ZIndex="70" Visibility="Collapsed"
                      DragDelta="MapTaskHeightSplitter_DragDelta"
                      DragCompleted="MapTaskSplitter_DragCompleted"
                      ToolTip="拖动：调整地图与任务面板高度" />

    <Button x:Name="LibraryPaneToggleButton" Grid.Row="1" Grid.Column="2" Style="{StaticResource IconButton}" Width="26" Height="48" Padding="0" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="8,0,0,0" Content="‹" ToolTip="收起地图列表" Click="LibraryPaneToggleButton_Click" Panel.ZIndex="80" />
    <Button x:Name="InspectorPaneToggleButton" Grid.Row="1" Grid.Column="2" Style="{StaticResource IconButton}" Width="26" Height="48" Padding="0" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0" Content="›" ToolTip="收起本局状态" Click="InspectorPaneToggleButton_Click" Panel.ZIndex="80" />
    <Border x:Name="ToastBorder" Grid.Row="1" Grid.Column="2" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,18" Padding="13,9" Background="#1A231F" BorderBrush="{StaticResource LineBrightBrush}" BorderThickness="1" CornerRadius="8" Visibility="Collapsed" Panel.ZIndex="100"><TextBlock x:Name="ToastText" FontSize="12" /></Border>
  </Grid>
</Window>
