              <Canvas x:Name="DynamicMarkerCanvas" IsHitTestVisible="True" />
              <Image x:Name="MapTransitionImage" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0" Visibility="Collapsed" IsHitTestVisible="False" SnapsToDevicePixels="True" />
            </Grid>
          </Grid>
        </Border>

        <Border x:Name="AirdropLocatorPanel" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="16,0,0,92" Width="324" Padding="12,10" Background="#EC121816" BorderBrush="{StaticResource AirdropABrush}" BorderThickness="1" CornerRadius="9" Visibility="Collapsed" Panel.ZIndex="18">
          <Grid>
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
              <StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Ellipse x:Name="AirdropStateDot" Width="6" Height="6" Fill="{StaticResource AirdropABrush}" Margin="0,0,7,0" /><TextBlock x:Name="AirdropStatusTitleText" Text="等待 A 点截图" Foreground="{StaticResource TextBrush}" FontSize="12" FontWeight="SemiBold" /></StackPanel>
              <StackPanel Grid.Column="1" Orientation="Horizontal"><Button Style="{StaticResource TacticalButton}" Content="重置" Height="27" Padding="8,0" FontSize="10" Click="AirdropResetButton_Click" /><Button Style="{StaticResource TacticalButton}" Content="退出" Height="27" Padding="8,0" FontSize="10" Margin="6,0,0,0" Click="AirdropExitButton_Click" /></StackPanel>
            </Grid>
            <TextBlock Grid.Row="1" x:Name="AirdropStatusDetailText" Text="瞄准空投后按 · 截取第一张坐标图" Foreground="{StaticResource TextDimBrush}" FontSize="10" TextWrapping="Wrap" Margin="0,8,0,0" />
            <TextBlock Grid.Row="2" x:Name="AirdropSampleText" Text="A —  B —" Foreground="{StaticResource TextFaintBrush}" FontFamily="Cascadia Mono" FontSize="9" TextWrapping="Wrap" Margin="0,7,0,0" />
          </Grid>
        </Border>

        <Border HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="16" Padding="11,9" MinWidth="188" Background="#141B18" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="8" Panel.ZIndex="10"><StackPanel><StackPanel Orientation="Horizontal"><Ellipse Width="5" Height="5" Fill="{StaticResource AmberBrush}" Margin="0,0,6,0" VerticalAlignment="Center" /><TextBlock Text="最近坐标" Foreground="{StaticResource TextFaintBrush}" FontSize="10" /></StackPanel><TextBlock Text="{Binding CurrentMapCoordinate}" FontFamily="Cascadia Mono" FontSize="12" FontWeight="SemiBold" Margin="0,4,0,0" /><TextBlock Text="{Binding CurrentCoordinateStatus}" Foreground="{StaticResource TextFaintBrush}" FontSize="10" Margin="0,4,0,0" /></StackPanel></Border>

        <StackPanel HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="16" Panel.ZIndex="10"><Border Background="#141B18" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="8"><StackPanel><Button Style="{StaticResource IconButton}" BorderThickness="0,0,0,1" BorderBrush="{StaticResource LineBrush}" Content="+" Click="ZoomIn_Click" /><Button Style="{StaticResource IconButton}" BorderThickness="0,0,0,1" BorderBrush="{StaticResource LineBrush}" Content="⟳" FontSize="14" Click="ResetMap_Click" /><Button Style="{StaticResource IconButton}" BorderThickness="0" Content="−" Click="ZoomOut_Click" /></StackPanel></Border></StackPanel>

        <Border HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="220,0,57,16" Padding="9,4" Background="#141B18" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="8" Panel.ZIndex="10"><WrapPanel><TextBlock Text="● 当前位置" Foreground="{StaticResource PlayerBrush}" FontSize="10" Margin="0,2" /><TextBlock Text="● 过期位置" Foreground="{StaticResource StalePlayerBrush}" FontSize="10" Margin="10,2,0,2" /><TextBlock Text="● 队友" Foreground="{StaticResource AmberBrush}" FontSize="10" Margin="10,2,0,2" /><TextBlock Text="● 撤离点" Foreground="{StaticResource GreenBrush}" FontSize="10" Margin="10,2,0,2" /><TextBlock Text="● 转移点" Foreground="{StaticResource AmberBrush}" FontSize="10" Margin="10,2,0,2" /><TextBlock Text="● 钥匙房" Foreground="{StaticResource KeyRoomBrush}" FontSize="10" Margin="10,2,0,2" /><TextBlock Text="● 拉闸点" Foreground="{StaticResource SwitchBrush}" FontSize="10" Margin="10,2,0,2" /><TextBlock Text="● BTR 预测" Foreground="#EAB308" FontSize="10" Margin="10,2,0,2" /><TextBlock Text="● 任务点" Foreground="{StaticResource TaskBrush}" FontSize="10" Margin="10,2,0,2" /></WrapPanel></Border>
      </Grid>
