<Window x:Class="TarkovMapLocatorDesktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="clr-namespace:TarkovMapLocatorDesktop.Models"
        xmlns:primitives="clr-namespace:System.Windows.Controls.Primitives;assembly=PresentationFramework"
        Title="塔科夫工具箱"
        Icon="assets/branding/app-icon.ico"
        Width="1440" Height="800" MinWidth="760" MinHeight="620"
        WindowStartupLocation="Manual" Background="{StaticResource CanvasBrush}"
        FontFamily="Microsoft YaHei UI" Foreground="{StaticResource TextBrush}"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType">
  <Window.Resources>
    <Style x:Key="PageTitle" TargetType="TextBlock">
      <Setter Property="FontSize" Value="28" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="Margin" Value="0,3,0,0" />
      <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
    </Style>

    <Style x:Key="PageToolbarButton" TargetType="Button" BasedOn="{StaticResource TacticalButton}">
      <Setter Property="Height" Value="36" />
      <Setter Property="MinWidth" Value="54" />
      <Setter Property="Padding" Value="12,0" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="MapUtilityButton" TargetType="Button" BasedOn="{StaticResource TacticalButton}">
      <Setter Property="Height" Value="34" />
      <Setter Property="Padding" Value="10,0" />
      <Setter Property="Background" Value="{StaticResource RaisedBrush}" />
      <Setter Property="BorderBrush" Value="{StaticResource LineBrightBrush}" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="PageFilterButton" TargetType="Button" BasedOn="{StaticResource TacticalButton}">
      <Setter Property="Height" Value="32" />
      <Setter Property="MinWidth" Value="62" />
      <Setter Property="Padding" Value="11,0" />
      <Setter Property="FontSize" Value="11" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="PageActionButton" TargetType="Button" BasedOn="{StaticResource TacticalButton}">
      <Setter Property="Height" Value="34" />
      <Setter Property="MinWidth" Value="76" />
      <Setter Property="Padding" Value="12,0" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="WorkbenchPaneSplitter" TargetType="{x:Type primitives:Thumb}">
      <Setter Property="Width" Value="8" />
      <Setter Property="HorizontalAlignment" Value="Center" />
      <Setter Property="VerticalAlignment" Value="Stretch" />
      <Setter Property="Cursor" Value="SizeWE" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="{x:Type primitives:Thumb}">
            <Border x:Name="SplitterHost" Background="Transparent" Padding="3,0">
              <Border x:Name="SplitterGrip" Width="2" CornerRadius="1" Background="{StaticResource LineBrush}" Opacity=".72" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="SplitterGrip" Property="Background" Value="{StaticResource AmberBrush}" /><Setter TargetName="SplitterGrip" Property="Opacity" Value="1" /></Trigger>
              <Trigger Property="IsDragging" Value="True"><Setter TargetName="SplitterGrip" Property="Background" Value="{StaticResource GreenBrush}" /><Setter TargetName="SplitterGrip" Property="Opacity" Value="1" /></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="WorkbenchRowSplitter" TargetType="{x:Type primitives:Thumb}">
      <Setter Property="Height" Value="8" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Cursor" Value="SizeNS" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="{x:Type primitives:Thumb}">
            <Border x:Name="SplitterHost" Background="Transparent" Padding="0,3">
              <Border x:Name="SplitterGrip" Height="2" CornerRadius="1" Background="{StaticResource LineBrush}" Opacity=".72" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="SplitterGrip" Property="Background" Value="{StaticResource AmberBrush}" /><Setter TargetName="SplitterGrip" Property="Opacity" Value="1" /></Trigger>
              <Trigger Property="IsDragging" Value="True"><Setter TargetName="SplitterGrip" Property="Background" Value="{StaticResource GreenBrush}" /><Setter TargetName="SplitterGrip" Property="Opacity" Value="1" /></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="WeaponTreeExpanderToggle" TargetType="{x:Type ToggleButton}">
      <Setter Property="Width" Value="24" />
      <Setter Property="MinHeight" Value="24" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Focusable" Value="False" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="{x:Type ToggleButton}">
            <Border x:Name="ArrowHost" Width="22" Height="22" Background="Transparent" CornerRadius="4">
              <Path x:Name="ArrowPath" Data="M 2,1 L 8,6 L 2,11" Width="10" Height="12" Stretch="Uniform" Stroke="#AFC6BC" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True"><Setter TargetName="ArrowPath" Property="Data" Value="M 1,2 L 6,8 L 11,2" /></Trigger>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ArrowHost" Property="Background" Value="#1C2823" /><Setter TargetName="ArrowPath" Property="Stroke" Value="{StaticResource AmberBrush}" /></Trigger>
              <Trigger Property="IsPressed" Value="True"><Setter TargetName="ArrowHost" Property="Background" Value="#26372F" /></Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter TargetName="ArrowPath" Property="Opacity" Value=".4" /></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="FormTextBox" TargetType="TextBox">
      <Setter Property="Height" Value="36" />
      <Setter Property="Padding" Value="10,0" />
      <Setter Property="Background" Value="{StaticResource RaisedBrush}" />
      <Setter Property="BorderBrush" Value="{StaticResource LineBrightBrush}" />
      <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
      <Setter Property="CaretBrush" Value="{StaticResource AmberBrush}" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <Style x:Key="FormComboBox" TargetType="ComboBox" BasedOn="{StaticResource DarkComboBox}">
      <Setter Property="Height" Value="36" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <Style x:Key="CurveValueBox" TargetType="TextBox">
      <Setter Property="Width" Value="56" />
      <Setter Property="Height" Value="28" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="Padding" Value="4,0" />
      <Setter Property="Background" Value="{StaticResource RaisedBrush}" />
      <Setter Property="BorderBrush" Value="{StaticResource LineBrightBrush}" />
      <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
      <Setter Property="CaretBrush" Value="{StaticResource AmberBrush}" />
      <Setter Property="FontFamily" Value="Cascadia Mono" />
      <Setter Property="FontSize" Value="10" />
    </Style>

    <Style x:Key="MapListItem" TargetType="ListBoxItem">
      <Setter Property="Margin" Value="0,0,0,3" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ListBoxItem">
            <Border x:Name="ItemBorder" Padding="7" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="8" RenderTransformOrigin=".5,.5">
              <Border.RenderTransform>
                <TranslateTransform x:Name="ItemSlide" X="0" />
              </Border.RenderTransform>
              <ContentPresenter />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsSelected" Value="True"><Setter TargetName="ItemBorder" Property="Background" Value="{StaticResource RaisedBrush}" /><Setter TargetName="ItemBorder" Property="BorderBrush" Value="{StaticResource LineBrightBrush}" /></Trigger>
              <EventTrigger RoutedEvent="MouseEnter">
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="ItemSlide" Storyboard.TargetProperty="X" To="3" Duration="0:0:0.16">
                      <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                  </Storyboard>
                </BeginStoryboard>
              </EventTrigger>
              <EventTrigger RoutedEvent="MouseLeave">
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="ItemSlide" Storyboard.TargetProperty="X" To="0" Duration="0:0:0.18">
                      <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                  </Storyboard>
                </BeginStoryboard>
              </EventTrigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <DataTemplate x:Key="MapTemplate" DataType="{x:Type models:MapDefinition}">
      <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="38" /><ColumnDefinition Width="*" /><ColumnDefinition Width="12" /></Grid.ColumnDefinitions>
        <Border Width="38" Height="38" CornerRadius="6" ClipToBounds="True" Background="#1E2824">
          <Image Source="{Binding ThumbnailSource}" Stretch="UniformToFill" Opacity=".82" />
        </Border>
        <StackPanel Grid.Column="1" Margin="10,0,4,0" VerticalAlignment="Center">
          <TextBlock Text="{Binding Name}" Foreground="{StaticResource TextBrush}" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
          <TextBlock Text="{Binding Subtitle}" Foreground="{StaticResource TextBrush}" Opacity=".82" FontSize="10" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" />
        </StackPanel>
        <Ellipse Grid.Column="2" Width="6" Height="6" Fill="{StaticResource AmberBrush}" VerticalAlignment="Center" Opacity=".65" />
      </Grid>
    </DataTemplate>

  </Window.Resources>

  <Grid x:Name="RootLayout">
    <Grid.ColumnDefinitions>
      <ColumnDefinition x:Name="RailColumn" Width="72" />
      <ColumnDefinition x:Name="LibraryColumn" Width="270" />
      <ColumnDefinition x:Name="ContentColumn" Width="*" />
      <ColumnDefinition x:Name="InspectorColumn" Width="310" />
    </Grid.ColumnDefinitions>
    <Grid.RowDefinitions>
      <RowDefinition x:Name="HeaderRow" Height="62" />
      <RowDefinition x:Name="MainRow" Height="*" />
    </Grid.RowDefinitions>

    <Border x:Name="RailPane" Grid.RowSpan="2" Grid.Column="0" Background="#111615" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,1,0">
      <Grid Margin="10,14,10,12">
        <Grid.RowDefinitions><RowDefinition Height="42" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <Button Grid.Row="0" Style="{StaticResource TacticalButton}" Width="42" Height="42" Padding="4" HorizontalAlignment="Center" Focusable="False" ToolTip="塔科夫工具箱">
          <Image Source="assets/branding/app-icon.png" Width="32" Height="32" Stretch="Uniform" SnapsToDevicePixels="True" />
        </Button>
        <ScrollViewer Grid.Row="1" Margin="0,18,0,0"
                      VerticalScrollBarVisibility="Hidden"
                      HorizontalScrollBarVisibility="Disabled"
                      PanningMode="VerticalOnly">
        <StackPanel VerticalAlignment="Top" Margin="0,1,0,0">
          <Button x:Name="MapRailButton" Style="{StaticResource RailButton}" Background="{StaticResource RaisedBrush}" BorderBrush="{StaticResource LineBrightBrush}" Foreground="{StaticResource AmberBrush}" Click="MapNavigation_Click"><StackPanel><Viewbox Width="20" Height="20" HorizontalAlignment="Center" Margin="0,0,0,2"><Canvas Width="24" Height="24"><Path Data="M3,6 L9,3 L15,6 L21,3 V18 L15,21 L9,18 L3,21 Z" Fill="Transparent" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" /><Path Data="M9,3 V18 M15,6 V21" Fill="Transparent" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" /></Canvas></Viewbox><TextBlock Text="地图" HorizontalAlignment="Center" Margin="0,1,0,0" /></StackPanel></Button>
          <Button x:Name="MarketRailButton" Style="{StaticResource RailButton}" Click="MarketNavigation_Click"><StackPanel><Viewbox Width="20" Height="20" HorizontalAlignment="Center" Margin="0,0,0,2"><Canvas Width="24" Height="24"><Path Data="M3,6 H21" Fill="Transparent" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="2" StrokeStartLineCap="Round" /><Path Data="M4,6 L6,3 H18 L20,6 V21 H4 Z" Fill="Transparent" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" /><Path Data="M8,10 A4,4 0 0 0 16,10" Fill="Transparent" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="2" StrokeStartLineCap="Round" /></Canvas></Viewbox><TextBlock Text="市场" HorizontalAlignment="Center" Margin="0,1,0,0" /></StackPanel></Button>
          <Button x:Name="InGamePriceRailButton" Style="{StaticResource RailButton}" Click="InGamePriceNavigation_Click" ToolTip="游戏内 OCR 识图查价"><StackPanel><Viewbox Width="20" Height="20" HorizontalAlignment="Center" Margin="0,0,0,2"><Canvas Width="24" Height="24"><Ellipse Width="16" Height="16" Canvas.Left="4" Canvas.Top="4" Fill="Transparent" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="2" /><Path Data="M12,1 V5 M12,19 V23 M1,12 H5 M19,12 H23 M9,12 H15 M12,9 V15" Fill="Transparent" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="2" StrokeStartLineCap="Round" /></Canvas></Viewbox><TextBlock Text="识价" HorizontalAlignment="Center" Margin="0,1,0,0" /></StackPanel></Button>
          <Button x:Name="TaskItemsRailButton" Style="{StaticResource RailButton}" Click="TaskItemsNavigation_Click"><StackPanel><Viewbox Width="20" Height="20" HorizontalAlignment="Center" Margin="0,0,0,2"><Canvas Width="24" Height="24"><Path Data="M13,5 H21 M13,12 H21 M13,19 H21" Fill="Transparent" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="2" StrokeStartLineCap="Round" /><Path Data="M3,7 L5,9 L9,5 M3,17 L5,19 L9,15" Fill="Transparent" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" /></Canvas></Viewbox><TextBlock Text="清单" HorizontalAlignment="Center" Margin="0,1,0,0" /></StackPanel></Button>
          <Button x:Name="MemoRailButton" Style="{StaticResource RailButton}" Click="MemoNavigation_Click"><StackPanel><Viewbox Width="20" Height="20" HorizontalAlignment="Center" Margin="0,0,0,2"><Canvas Width="24" Height="24"><Path Data="M5,3 H19 V21 H5 Z M8,8 H16 M8,12 H16 M8,16 H13" Fill="Transparent" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeLineJoin="Round" /></Canvas></Viewbox><TextBlock Text="备忘" HorizontalAlignment="Center" Margin="0,1,0,0" /></StackPanel></Button>
          <Button x:Name="TaskTrackingRailButton" Style="{StaticResource RailButton}" Click="TaskTrackingNavigation_Click"><StackPanel><Viewbox Width="20" Height="20" HorizontalAlignment="Center" Margin="0,0,0,2"><Canvas Width="24" Height="24"><Path Data="M5,5 H11 V10 H5 Z M13,14 H19 V19 H13 Z" Fill="Transparent" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.8" StrokeLineJoin="Round" /><Path Data="M11,7.5 H15 V12 M15,12 H8 V16.5 H13" Fill="Transparent" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeLineJoin="Round" /></Canvas></Viewbox><TextBlock Text="任务" HorizontalAlignment="Center" Margin="0,1,0,0" /></StackPanel></Button>
          <Button x:Name="ScreenFilterRailButton" Style="{StaticResource RailButton}" Click="ScreenFilterNavigation_Click"><StackPanel><Viewbox Width="20" Height="20" HorizontalAlignment="Center" Margin="0,0,0,2"><Canvas Width="24" Height="24"><Path Data="M4,6 H20 M4,12 H20 M4,18 H20" Fill="Transparent" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="2" StrokeStartLineCap="Round" /><Ellipse Width="5" Height="5" Canvas.Left="8" Canvas.Top="3.5" Fill="{StaticResource CanvasBrush}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="2" /><Ellipse Width="5" Height="5" Canvas.Left="14" Canvas.Top="9.5" Fill="{StaticResource CanvasBrush}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="2" /><Ellipse Width="5" Height="5" Canvas.Left="6" Canvas.Top="15.5" Fill="{StaticResource CanvasBrush}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="2" /></Canvas></Viewbox><TextBlock Text="调色" HorizontalAlignment="Center" Margin="0,1,0,0" /></StackPanel></Button>
          <Button x:Name="TeamSyncRailButton" Style="{StaticResource RailButton}" Click="TeamSyncNavigation_Click"><StackPanel><Viewbox Width="20" Height="20" HorizontalAlignment="Center" Margin="0,0,0,2"><Canvas Width="24" Height="24"><Path Data="M5,21 V18.5 A5.5,5.5 0 0 1 10.5,13 H13.5 A5.5,5.5 0 0 1 19,18.5 V21 M18,7 A2.5,2.5 0 0 1 21,9.5 M20,20 V18.5 A4.5,4.5 0 0 0 17.3,14.4" Fill="Transparent" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" /><Ellipse Width="6" Height="6" Canvas.Left="9" Canvas.Top="3.5" Fill="Transparent" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="2" /></Canvas></Viewbox><TextBlock Text="队友" HorizontalAlignment="Center" Margin="0,1,0,0" /></StackPanel></Button>
          <Button x:Name="MobileMapRailButton" Style="{StaticResource RailButton}" Click="MobileMapNavigation_Click"><StackPanel><Viewbox Width="20" Height="20" HorizontalAlignment="Center" Margin="0,0,0,2"><Canvas Width="24" Height="24"><Rectangle Width="13" Height="21" Canvas.Left="5.5" Canvas.Top="1.5" RadiusX="2.5" RadiusY="2.5" Fill="Transparent" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.8" /><Ellipse Width="2" Height="2" Canvas.Left="11" Canvas.Top="18.5" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" /><Path Data="M8.5,6 L11,4.7 L13.5,6 L16,4.7 V13 L13.5,14.3 L11,13 L8.5,14.3 Z M11,4.7 V13 M13.5,6 V14.3" Fill="Transparent" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.2" StrokeLineJoin="Round" /></Canvas></Viewbox><TextBlock Text="手机" HorizontalAlignment="Center" Margin="0,1,0,0" /></StackPanel></Button>
          <Button x:Name="UtilitiesRailButton" Style="{StaticResource RailButton}" Click="UtilitiesNavigation_Click"><StackPanel><Viewbox Width="20" Height="20" HorizontalAlignment="Center" Margin="0,0,0,2"><Canvas Width="24" Height="24"><Path Data="M4,7 H20 V20 H4 Z M8,7 V4 H16 V7 M8,12 H16 M12,9 V15" Fill="Transparent" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" /></Canvas></Viewbox><TextBlock Text="小工具" HorizontalAlignment="Center" Margin="0,1,0,0" /></StackPanel></Button>
        </StackPanel>
        </ScrollViewer>
        <StackPanel Grid.Row="2" HorizontalAlignment="Center">
          <Button x:Name="SettingsRailButton" Style="{StaticResource RailButton}" Click="Settings_Click"><StackPanel><Viewbox Width="20" Height="20" HorizontalAlignment="Center" Margin="0,0,0,2"><Canvas Width="24" Height="24"><Ellipse Width="7" Height="7" Canvas.Left="8.5" Canvas.Top="8.5" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="2" /><Path Data="M12,2 V5 M12,19 V22 M2,12 H5 M19,12 H22 M4.9,4.9 L7,7 M17,17 L19.1,19.1 M19.1,4.9 L17,7 M7,17 L4.9,19.1" Fill="Transparent" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" /></Canvas></Viewbox><TextBlock Text="设置" HorizontalAlignment="Center" Margin="0,1,0,0" /></StackPanel></Button>
        </StackPanel>
      </Grid>
    </Border>

    <Border x:Name="TopBar" Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="3" Background="#121716" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1">
      <Grid Margin="22,0">
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" MaxWidth="460"><Ellipse Width="7" Height="7" Fill="{StaticResource GreenBrush}" Margin="0,0,8,0" VerticalAlignment="Center" /><TextBlock Text="{Binding AssetStatus}" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" /></StackPanel>
      </Grid>
    </Border>

    <Grid x:Name="LibraryPaneHost" Grid.Row="1" Grid.Column="1" ClipToBounds="True">
      <Border x:Name="LibraryPane" HorizontalAlignment="Left" Background="#121716" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,1,0" Padding="16,22,14,15">
        <Grid>
          <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
          <StackPanel><TextBlock Text="MAP LIBRARY" Style="{StaticResource SectionLabel}" /><TextBlock Text="地图" FontSize="20" FontWeight="SemiBold" Margin="0,3,0,0" /></StackPanel>
          <ListBox Grid.Row="1" Margin="0,14,0,0" x:Name="MapList" ItemsSource="{Binding Maps}" SelectionChanged="MapList_SelectionChanged" ItemTemplate="{StaticResource MapTemplate}" ItemContainerStyle="{StaticResource MapListItem}" Background="Transparent" Foreground="{StaticResource TextBrush}" BorderThickness="0" ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.IsDeferredScrollingEnabled="False" VirtualizingPanel.ScrollUnit="Pixel" />
          <Border Grid.Row="2" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0" Padding="0,13,0,0"><StackPanel Orientation="Horizontal"><Ellipse Width="6" Height="6" Fill="{StaticResource GreenBrush}" Margin="0,0,8,0" VerticalAlignment="Center" /><TextBlock Text="{Binding AssetStatus}" Foreground="{StaticResource TextFaintBrush}" FontSize="10" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" /></StackPanel></Border>
        </Grid>
      </Border>
    </Grid>

    <Grid x:Name="MapPage" Grid.Row="1" Grid.Column="2" Background="#101514" Margin="0">
      <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
      <Grid Margin="24,20,24,14">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
        <StackPanel VerticalAlignment="Bottom"><TextBlock Text="{Binding CurrentMapSubtitle}" Style="{StaticResource SectionLabel}" /><TextBlock Text="{Binding CurrentMapName}" Style="{StaticResource PageTitle}" /></StackPanel>
        <Border Grid.Column="1" Background="#131917" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="8" Padding="0" VerticalAlignment="Bottom">
          <Border.ToolTip><TextBlock Text="{Binding CurrentMapRaidStatsNote}" MaxWidth="380" TextWrapping="Wrap" /></Border.ToolTip>
          <StackPanel Orientation="Horizontal">
            <StackPanel Margin="10,7"><TextBlock Text="PMC" Foreground="{StaticResource TextFaintBrush}" FontSize="10" /><TextBlock Text="{Binding CurrentMapPlayers}" FontSize="12" FontWeight="SemiBold" /></StackPanel>
            <Border Width="1" Background="{StaticResource LineBrush}" />
            <StackPanel Margin="10,7"><TextBlock Text="撤离 / 转移" Foreground="{StaticResource TextFaintBrush}" FontSize="10" /><TextBlock Text="{Binding CurrentMapExtracts}" FontSize="12" FontWeight="SemiBold" /></StackPanel>
            <Border Width="1" Background="{StaticResource LineBrush}" />
            <StackPanel Margin="10,7"><TextBlock Text="时长" Foreground="{StaticResource TextFaintBrush}" FontSize="10" /><TextBlock Text="{Binding CurrentMapDuration}" FontSize="12" FontWeight="SemiBold" /></StackPanel>
          </StackPanel>
        </Border>
      </Grid>

      <Border Grid.Row="1" Background="#121716" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,1" Padding="24,8,24,8">
        <Grid>
          <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
          <WrapPanel x:Name="MapToolbarPanel" Orientation="Horizontal">
