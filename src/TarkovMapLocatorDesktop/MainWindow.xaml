              <Image x:Name="MapLayerImage" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0" Visibility="Collapsed" IsHitTestVisible="False" SnapsToDevicePixels="True" />
              <Image x:Name="MapLayerTransitionImage" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0" Visibility="Collapsed" IsHitTestVisible="False" SnapsToDevicePixels="True" />
