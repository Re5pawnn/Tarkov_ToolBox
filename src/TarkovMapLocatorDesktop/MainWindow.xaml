                  <CheckBox x:Name="BtrPointDisplayCheck" Content="BTR 位置预测" IsChecked="True" Checked="PointDisplayCheckChanged" Unchecked="PointDisplayCheckChanged" Foreground="{StaticResource TextDimBrush}" FontSize="12" Margin="0,3,20,3" ToolTip="森林与街区：依据游戏日志中的战局开始时间显示所有可能路线" />
